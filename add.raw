	end
end)

-- ============================================================
-- SCALE (resize character) v4 — save/restore original
-- ============================================================
C.scaleEn = false
C.scaleValue = 1.0
C._scaleOriginalDesc = nil
C._lastScaleToValue = nil

local SCALE_NV = {
	"BodyHeightScale",
	"BodyWidthScale",
	"BodyDepthScale",
	"HeadScale",
	"BodyProportionScale",
}

local function getScaleHum()
	return LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
end

local function saveOriginalDesc(hum)
	if not hum or C._scaleOriginalDesc then return end
	local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
	if ok and desc then
		C._scaleOriginalDesc = desc
	end
end

local function applyOriginalDesc(hum)
	if not hum or not C._scaleOriginalDesc then return false end
	local ok = pcall(function() hum:ApplyDescription(C._scaleOriginalDesc) end)
	return ok
end

local function tryApplyDescription(hum, s)
	if not hum then return false end
	local ok = pcall(function()
		local desc = hum:GetAppliedDescription()
		if not desc then error("no desc") end
		desc.HeightScale = s
		desc.WidthScale = s
		desc.DepthScale = s
		desc.HeadScale = s
		hum:ApplyDescription(desc)
	end)
	return ok
end

local function tryNumberValues(hum, s)
	if not hum then return false end
	local applied = false
	for _, key in ipairs(SCALE_NV) do
		local nv = hum:FindFirstChild(key)
		if nv and nv:IsA("NumberValue") then
			local ok = pcall(function() nv.Value = s end)
			if ok then applied = true end
		end
	end
	pcall(function() hum.BodyHeightScale = s end)
	pcall(function() hum.BodyWidthScale = s end)
	pcall(function() hum.BodyDepthScale = s end)
	pcall(function() hum.HeadScale = s end)
	return applied
end

local function tryScaleTo(hum, s)
	local char = hum and hum.Parent
	if not char or not char:IsA("Model") then return false end
	local prev = C._lastScaleToValue or 1
	local target = s / prev
	if math.abs(target - 1) < 0.05 then return false end
	local ok = pcall(function() char:ScaleTo(target) end)
	if ok then C._lastScaleToValue = s end
	return ok
end

local function applyScale()
	local hum = getScaleHum()
	if not hum then return end
	if C.scaleEn then
		saveOriginalDesc(hum)
		local s = C.scaleValue
		pcall(function() hum.AutomaticScalingEnabled = false end)
		local ok1 = tryApplyDescription(hum, s)
		if not ok1 then
			local ok2 = tryNumberValues(hum, s)
			if not ok2 then
				tryScaleTo(hum, s)
			end
		end
	end
end

local function resetScale()
	local hum = getScaleHum()
	if not hum then
		C._scaleOriginalDesc = nil
		C._lastScaleToValue = nil
		return
	end
	pcall(function() hum.AutomaticScalingEnabled = true end)

	-- Method 3 rollback (ScaleTo)
	local char = hum.Parent
	local prev = C._lastScaleToValue
	if char and prev and math.abs(prev - 1) > 0.05 and char:IsA("Model") then
		pcall(function() char:ScaleTo(1 / prev) end)
	end

	-- Method 1: restore original description
	local ok = applyOriginalDesc(hum)

	-- Method 2 fallback
	if not ok then
		tryNumberValues(hum, 1)
	end

	C._scaleOriginalDesc = nil
	C._lastScaleToValue = nil
end

local function scaleSyncLoop()
	if not C.scaleEn then
		pcall(function()
			local hum = getScaleHum()
			if hum then hum.AutomaticScalingEnabled = true end
		end)
		return
	end
	local hum = getScaleHum()
	if not hum then return end
	local cur = false
	pcall(function() cur = hum.AutomaticScalingEnabled end)
	if cur then pcall(function() hum.AutomaticScalingEnabled = false end) end
	local check = 0
	pcall(function() check = hum.BodyHeightScale end)
	if math.abs(check - C.scaleValue) > 0.05 then
		tryApplyDescription(hum, C.scaleValue)
	end
end

addR("Visual",
	t("scale").." ("..string.format("%.1f", C.scaleValue)..")",
	function(b, a)
		if a == "toggle" then
			C.scaleEn = not C.scaleEn
			if C.scaleEn then
				S.addT("UCS_ScaleSync", scaleSyncLoop, 0.8)
				task.defer(applyScale)
			else
				S.delT("UCS_ScaleSync")
				task.defer(resetScale)
			end
		elseif a == "minus" then
			C.scaleValue = math.max(0.1, C.scaleValue - 0.1)
			if C.scaleEn then applyScale() end
		elseif a == "plus" then
			C.scaleValue = C.scaleValue + 0.1
			if C.scaleEn then applyScale() end
		end
		b.Text = t("scale")..": "..(C.scaleEn and t("on") or t("off")).." ("..string.format("%.1f", C.scaleValue)..")"
		b.BackgroundColor3 = C.scaleEn and Color3.fromRGB(0,120,0) or Color3.fromRGB(50,50,50)
	end,
	true, "scaleEn", "scaleValue")

S._resetScale = function()
	C.scaleEn = false
	S.delT("UCS_ScaleSync")
	resetScale()
end

LP.CharacterAdded:Connect(function(c)
	task.wait(1.2)
	if C.scaleEn then
		local hum = c:WaitForChild("Humanoid", 5)
		if hum then
			C._scaleOriginalDesc = nil
			C._lastScaleToValue = nil
			task.defer(applyScale)
		end
	end
end)

onLangChange(function()
	local tb = S.toggles.scaleEn and S.toggles.scaleEn.btn
	if tb and tb.Parent then
		tb.Text = t("scale")..": "..(C.scaleEn and t("on") or t("off")).." ("..string.format("%.1f", C.scaleValue)..")"
	end
end)

-- ============================================================
-- SEARCH + STARS
-- ============================================================
local funRows = {}
local rowOrder = {}

local function fixTabOrder(tab)
	local lay = tab:FindFirstChildOfClass("UIListLayout")
	if lay then lay.SortOrder = Enum.SortOrder.LayoutOrder end
	local idx = 0
	for _, child in ipairs(tab:GetChildren()) do
		if child.Name ~= "UCS_SearchBox" and child.Name ~= "ACE_SearchBox" and child:IsA("GuiObject") then
			local ok = pcall(function() return child.LayoutOrder end)
			if ok then
				idx = idx + 1
				rowOrder[child] = idx
				child.LayoutOrder = idx
			end
		end
	end
end

local function indexRows()
	funRows = {}
	rowOrder = {}
	for _, tabName in ipairs({"Main","Func","Visual","WP","Addons","Settings"}) do
		local tab = S.Tabs[tabName]
		if tab then
			fixTabOrder(tab)
			for _, child in ipairs(tab:GetChildren()) do
				if child:IsA("Frame") then
					for k, tg in pairs(S.toggles) do
						if tg.btn and tg.btn.Parent == child then
							funRows[child] = k
							break
						end
					end
				end
			end
		end
	end
end

local function reorderAll()
	local favs = getFavs()
	local favIdx = 0
	for row, key in pairs(funRows) do
		if row and row.Parent then
			if favs[key] then
				favIdx = favIdx + 1
				row.LayoutOrder = -10000 + favIdx
			else
				row.LayoutOrder = rowOrder[row] or 99999
			end
		end
	end
end

local function addStar(row, key)
	if row:FindFirstChild("UCS_FavStar") then return end
	local mainBtn, sldMinus, sldPlus = nil, nil, nil
	for _, c in ipairs(row:GetChildren()) do
		if c:IsA("TextButton") and c.Name ~= "UCS_FavStar" then
			if not mainBtn then mainBtn = c
			elseif not sldMinus then sldMinus = c
			else sldPlus = c end
		end
	end
	if not mainBtn then return end

	if sldPlus then
		mainBtn.Size = UDim2.new(1, -88, 1, 0)
		sldMinus.Size = UDim2.new(0, 25, 1, 0); sldMinus.Position = UDim2.new(1, -86, 0, 0)
		sldPlus.Size = UDim2.new(0, 25, 1, 0);  sldPlus.Position = UDim2.new(1, -58, 0, 0)
	else
		mainBtn.Size = UDim2.new(1, -32, 1, 0)
	end

	local star = Instance.new("TextButton", row)
	star.Name = "UCS_FavStar"
	star.Size = UDim2.new(0, 26, 1, 0)
	star.Position = UDim2.new(1, -28, 0, 0)
	star.BackgroundColor3 = Color3.fromRGB(60,60,60)
	star.BorderSizePixel = 0
	star.Text = "☆"
	star.TextColor3 = Color3.fromRGB(255,220,80)
	star.Font = Enum.Font.SourceSansBold
	star.TextSize = 14
	star.ZIndex = 5
	Instance.new("UICorner", star).CornerRadius = UDim.new(0,4)
	local function refreshStar()
		local favs = getFavs()
		if favs[key] then
			star.Text = "★"; star.BackgroundColor3 = Color3.fromRGB(180,140,20)
		else
			star.Text = "☆"; star.BackgroundColor3 = Color3.fromRGB(60,60,60)
		end
	end
	refreshStar()
	star.MouseButton1Click:Connect(function()
		toggleFav(key); refreshStar(); reorderAll()
	end)
end

local function addSearchToTab(tabName)
	local tab = S.Tabs[tabName]
	if not tab or tab:FindFirstChild("UCS_SearchBox") then return end
	local box = Instance.new("TextBox", tab)
	box.Name = "UCS_SearchBox"
	box.Size = UDim2.new(1, -5, 0, 28)
	box.BackgroundColor3 = Color3.fromRGB(45,45,45)
	box.BorderSizePixel = 0
	box.PlaceholderText = t("search_ph")
	box.Text = ""
	box.TextColor3 = Color3.new(1,1,1)
	box.PlaceholderColor3 = Color3.fromRGB(140,140,140)
	box.Font = Enum.Font.SourceSansBold
	box.TextSize = 11
	box.ClearTextOnFocus = false
	box.LayoutOrder = -99999
	Instance.new("UICorner", box).CornerRadius = UDim.new(0,4)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local q = string.lower(box.Text or "")
		for row, _ in pairs(funRows) do
			if row and row.Parent == tab then
				local mainBtn = nil
				for _, c in ipairs(row:GetChildren()) do
					if c:IsA("TextButton") and c.Name ~= "UCS_FavStar" then mainBtn = c; break end
				end
				if mainBtn then
					local txt = string.lower(mainBtn.Text or "")
					row.Visible = (q == "") or (string.find(txt, q, 1, true) ~= nil)
				end
			end
		end
	end)
end

task.spawn(function()
	task.wait(0.7)
	indexRows()
	for _, tabName in ipairs({"Main","Func","Visual","WP","Addons","Settings"}) do
		addSearchToTab(tabName)
	end
	for row, key in pairs(funRows) do
		if row and row.Parent then addStar(row, key) end
	end
	reorderAll()
	local n = 0
	for _ in pairs(funRows) do n = n + 1 end
	print(t("search_ready")..n)
end)

onLangChange(function()
	for _, tabName in ipairs({"Main","Func","Visual","WP","Addons","Settings"}) do
		local tab = S.Tabs[tabName]
		if tab then
			local box = tab:FindFirstChild("UCS_SearchBox")
			if box then box.PlaceholderText = t("search_ph") end
		end
	end
end)

S._extrasCleanup = function()
	if S._setFreecam and C.freecam then S._setFreecam(false) end
	if S._resetScale then pcall(S._resetScale) end
	if ipConn then ipConn:Disconnect() end
	if S._freeButtons then
		for _,b in ipairs(S._freeButtons) do pcall(function() b:Destroy() end) end
	end
	if infoPanel then infoPanel:Destroy() end
	if hkPanel then hkPanel:Destroy() end
end

print(t("done"))
