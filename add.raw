-- ============================================================
-- SCALE (resize character) v6 — all methods + hook
-- ============================================================
C.scaleEn = false
C.scaleValue = 1.0
C.scaleUseServer = false
C.scaleUseHook = false
C._scaleOriginalDesc = nil
C._lastScaleToValue = nil
C._hookActive = false
C._origNameCall = nil
C._origIndex = nil
C._origNewIndex = nil

local SCALE_NV = {
	"BodyHeightScale","BodyWidthScale","BodyDepthScale","HeadScale","BodyProportionScale",
}

local REMOTE_NAMES = {
	"SetScale","ChangeScale","UpdateScale","Resize","SetSize","ChangeSize",
	"ScaleRemote","SizeEvent","ApplyScale","SetCharacterScale",
	"UpdateCharacterScale","ChangeCharacterSize","ResizeCharacter",
	"SetBodyScale","UpdateBodyScale","BodyScale","CharacterSize",
	"SetAvatarScale","UpdateAvatarScale","SetPlayerScale","ChangePlayerSize",
	"SetHeight","ChangeHeight","UpdateHeight","SetWidth","ChangeWidth",
	"SetCharacter","UpdateCharacter","ChangeCharacter","CharacterEvent",
	"ApplyDescription","SetDescription","UpdateDescription","ChangeDescription",
	"ApplyHumanoidDescription","SetHumanoidDescription","UpdateHumanoid",
	"Avatar","AvatarEvent","SetAvatar","UpdateAvatar","ChangeAvatar",
	"CreateCharacter","ModifyCharacter","Transform","TransformCharacter",
	"Modify","ModifyPlayer","ModifyAvatar","ModifyBody",
	"SetProperty","UpdateProperty","ChangeProperty",
	"RunCommand","ExecuteCommand","Command","AdminCommand",
	"SetPlayerProperty","AdminSet","AdminChange",
	"ScaleCharacter","SetScaleRemote","ChangeScaleRequest",
	"ResizeCharacter","SetCharacterSize","SetPlayerSize",
	"UpdateCharacterRequest","ResizePlayer",
	"SetScale_Server","ScaleEvent","ScaleRequest","ScaleSync",
	"SizeChange","SizeUpdate","SizeRequest",
	"CharacterScale","PlayerScale","HumanoidScale",
	"ResizeEvent","ResizeRequest","ResizeServer",
}

local MODULE_NAMES = {
	"CharacterScale","ScaleManager","SizeManager","CharacterAPI",
	"PlayerAPI","AvatarAPI","BodyAPI","HumanoidAPI",
	"CharacterService","PlayerService","AvatarService",
	"ResizeService","ScaleService","HeightService",
}

local ATTR_KEYS = {
	"Scale","Size","HeightScale","WidthScale","DepthScale","HeadScale","BodyScale",
}

local function getScaleHum()
	return LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
end

local function saveOriginalDesc(hum)
	if not hum or C._scaleOriginalDesc then return end
	local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
	if ok and desc then C._scaleOriginalDesc = desc end
end

local function applyOriginalDesc(hum)
	if not hum or not C._scaleOriginalDesc then return false end
	return pcall(function() hum:ApplyDescription(C._scaleOriginalDesc) end)
end

local function tryApplyDescription(hum, s)
	if not hum then return false end
	return pcall(function()
		local desc = hum:GetAppliedDescription()
		if not desc then error("no desc") end
		desc.HeightScale = s
		desc.WidthScale = s
		desc.DepthScale = s
		desc.HeadScale = s
		hum:ApplyDescription(desc)
	end)
end

local function tryNumberValues(hum, s)
	if not hum then return false end
	local applied = false
	for _, key in ipairs(SCALE_NV) do
		local nv = hum:FindFirstChild(key)
		if nv and nv:IsA("NumberValue") then
			if pcall(function() nv.Value = s end) then applied = true end
		end
	end
	pcall(function() hum.BodyHeightScale = s end)
	pcall(function() hum.BodyWidthScale = s end)
	pcall(function() hum.BodyDepthScale = s end)
	pcall(function() hum.HeadScale = s end)
	return applied
end

local function tryScaleTo(hum, s)
	local char = hum and hum.Parent
	if not char or not char:IsA("Model") then return false end
	local prev = C._lastScaleToValue or 1
	local target = s / prev
	if math.abs(target - 1) < 0.05 then return false end
	local ok = pcall(function() char:ScaleTo(target) end)
	if ok then C._lastScaleToValue = s end
	return ok
end

local function tryAttributes(s)
	local char = LP.Character
	local hum = getScaleHum()
	local applied = false
	if char then
		for _, k in ipairs(ATTR_KEYS) do
			if pcall(function() char:SetAttribute(k, s) end) then applied = true end
		end
	end
	if hum then
		for _, k in ipairs(ATTR_KEYS) do
			if pcall(function() hum:SetAttribute(k, s) end) then applied = true end
		end
	end
	return applied
end

local function tryChildValues(s)
	local char = LP.Character
	if not char then return false end
	local applied = false
	for _, o in ipairs(char:GetDescendants()) do
		if o:IsA("NumberValue") or o:IsA("StringValue") then
			local ln = o.Name:lower()
			if ln:find("scale") or ln:find("size") or ln:find("height") or ln:find("width") then
				local ok = pcall(function()
					if o:IsA("NumberValue") then o.Value = s
					else o.Value = tostring(s) end
				end)
				if ok then applied = true end
			end
		end
	end
	return applied
end

local function findRemoteDeep(root, name)
	local found = root:FindFirstChild(name)
	if found then return found end
	return root:FindFirstChild(name, true)
end

local function tryRemoteScale(s, verbose)
	if not C.scaleUseServer then return false end
	local rs = game:GetService("ReplicatedStorage")
	local foundAny = false
	for _, name in ipairs(REMOTE_NAMES) do
		local remote = findRemoteDeep(rs, name)
		if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
			foundAny = true
			if verbose then
				print("[UCS-Scale] Found remote:", remote:GetFullName(), remote.ClassName)
			end
			local hum = getScaleHum()
			local char = LP.Character
			if remote:IsA("RemoteEvent") then
				pcall(function() remote:FireServer(s) end)
				pcall(function() remote:FireServer(char, s) end)
				pcall(function() remote:FireServer(LP, s) end)
				pcall(function() remote:FireServer("SetScale", s) end)
				pcall(function() remote:FireServer("Scale", s) end)
				pcall(function() remote:FireServer("Resize", s) end)
				pcall(function() remote:FireServer({Scale=s, HeightScale=s, WidthScale=s, DepthScale=s, HeadScale=s}) end)
				pcall(function() remote:FireServer(hum, s) end)
			elseif remote:IsA("RemoteFunction") then
				pcall(function() remote:InvokeServer(s) end)
				pcall(function() remote:InvokeServer(char, s) end)
				pcall(function() remote:InvokeServer({Scale=s}) end)
			end
		end
	end
	return foundAny
end

local function tryModuleScale(s)
	if not C.scaleUseServer then return false end
	local rs = game:GetService("ReplicatedStorage")
	for _, modName in ipairs(MODULE_NAMES) do
		local mod = findRemoteDeep(rs, modName)
		if mod and mod:IsA("ModuleScript") then
			local ok, api = pcall(require, mod)
			if ok and type(api) == "table" then
				for name, fn in pairs(api) do
					local ln = tostring(name):lower()
					if type(fn) == "function" and (ln:find("scale") or ln:find("size") or ln:find("resize")) then
						pcall(fn, s)
						pcall(fn, LP, s)
						pcall(fn, LP.Character, s)
					end
				end
				return true
			end
		end
	end
	return false
end

local function hookAvailable()
	return (hookmetamethod and getnamecallmethod and newcclosure and getrawmetatable and setreadonly) ~= nil
end

local function enableHook()
	if C._hookActive then return false end
	if not hookAvailable() then return false end

	local ok = pcall(function()
		local mt = getrawmetatable(game)
		C._origNameCall = mt.__namecall
		C._origIndex    = mt.__index
		C._origNewIndex = mt.__newindex

		setreadonly(mt, false)

		mt.__namecall = newcclosure(function(self, ...)
			local method = getnamecallmethod()
			if C.scaleEn and (method == "FireServer" or method == "InvokeServer") then
				local args = {...}
				local modified = false
				for i = 1, #args do
					local arg = args[i]
					if type(arg) == "table" then
						local keyFound = false
						for _, k in ipairs({"HeightScale","WidthScale","DepthScale","HeadScale","Scale","Size"}) do
							if rawget(arg, k) ~= nil then keyFound = true; break end
						end
						if keyFound then
							args[i].HeightScale = C.scaleValue
							args[i].WidthScale  = C.scaleValue
							args[i].DepthScale  = C.scaleValue
							args[i].HeadScale   = C.scaleValue
							args[i].Scale       = C.scaleValue
							args[i].Size        = C.scaleValue
							modified = true
						end
					elseif type(arg) == "number" then
						local sn = self.Name and string.lower(self.Name) or ""
						if sn:find("scale") or sn:find("size") or sn:find("height") or sn:find("resize") then
							args[i] = C.scaleValue
							modified = true
						end
					end
				end
				if modified then
					return C._origNameCall(self, table.unpack(args))
				end
			end
			return C._origNameCall(self, ...)
		end)

		mt.__index = newcclosure(function(self, key)
			if C.scaleEn and typeof(self) == "Instance" then
				local ok2, isHum = pcall(function() return self:IsA("Humanoid") end)
				if ok2 and isHum and self == getScaleHum() then
					if key == "BodyHeightScale" or key == "BodyWidthScale" or key == "BodyDepthScale" or key == "HeadScale" then
						return C.scaleValue
					end
				end
			end
			return C._origIndex(self, key)
		end)

		setreadonly(mt, true)
		C._hookActive = true
	end)

	return ok
end

local function disableHook()
	if not C._hookActive then return end
	pcall(function()
		local mt = getrawmetatable(game)
		setreadonly(mt, false)
		if C._origNameCall then mt.__namecall = C._origNameCall end
		if C._origIndex    then mt.__index    = C._origIndex end
		setreadonly(mt, true)
	end)
	C._origNameCall = nil
	C._origIndex = nil
	C._origNewIndex = nil
	C._hookActive = false
end

local function applyScale()
	local hum = getScaleHum()
	if not hum then return end
	if C.scaleEn then
		saveOriginalDesc(hum)
		local s = C.scaleValue
		pcall(function() hum.AutomaticScalingEnabled = false end)

		local ok1 = tryApplyDescription(hum, s)
		if not ok1 then
			local ok2 = tryNumberValues(hum, s)
			if not ok2 then
				tryScaleTo(hum, s)
			end
		end

		tryChildValues(s)
		tryAttributes(s)
		tryRemoteScale(s, false)
		tryModuleScale(s)
	end
end

local function resetScale()
	local hum = getScaleHum()
	if not hum then
		C._scaleOriginalDesc = nil
		C._lastScaleToValue = nil
		return
	end
	pcall(function() hum.AutomaticScalingEnabled = true end)

	local char = hum.Parent
	local prev = C._lastScaleToValue
	if char and prev and math.abs(prev - 1) > 0.05 and char:IsA("Model") then
		pcall(function() char:ScaleTo(1 / prev) end)
	end

	local ok = applyOriginalDesc(hum)
	if not ok then tryNumberValues(hum, 1) end

	if LP.Character then
		for _, k in ipairs(ATTR_KEYS) do
			pcall(function() LP.Character:SetAttribute(k, nil) end)
		end
	end
	pcall(function() hum:SetAttribute("Scale", nil) end)

	if C.scaleUseServer then
		tryRemoteScale(1, false)
	end

	C._scaleOriginalDesc = nil
	C._lastScaleToValue = nil
end

local function scaleSyncLoop()
	if not C.scaleEn then
		pcall(function()
			local hum = getScaleHum()
			if hum then hum.AutomaticScalingEnabled = true end
		end)
		return
	end
	local hum = getScaleHum()
	if not hum then return end
	local cur = false
	pcall(function() cur = hum.AutomaticScalingEnabled end)
	if cur then pcall(function() hum.AutomaticScalingEnabled = false end) end
	local check = 0
	pcall(function() check = hum.BodyHeightScale end)
	if math.abs(check - C.scaleValue) > 0.05 then
		tryApplyDescription(hum, C.scaleValue)
		if C.scaleUseServer then
			tryRemoteScale(C.scaleValue, false)
		end
	end
end

addR("Visual",
	t("scale").." ("..string.format("%.1f", C.scaleValue)..")",
	function(b, a)
		if a == "toggle" then
			C.scaleEn = not C.scaleEn
			if C.scaleEn then
				S.addT("UCS_ScaleSync", scaleSyncLoop, 0.8)
				task.defer(applyScale)
			else
				S.delT("UCS_ScaleSync")
				task.defer(resetScale)
			end
		elseif a == "minus" then
			C.scaleValue = math.max(0.1, C.scaleValue - 0.1)
			if C.scaleEn then applyScale() end
		elseif a == "plus" then
			C.scaleValue = C.scaleValue + 0.1
			if C.scaleEn then applyScale() end
		end
		b.Text = t("scale")..": "..(C.scaleEn and t("on") or t("off")).." ("..string.format("%.1f", C.scaleValue)..")"
		b.BackgroundColor3 = C.scaleEn and Color3.fromRGB(0,120,0) or Color3.fromRGB(50,50,50)
	end,
	true, "scaleEn", "scaleValue")

addR("Visual",
	t("scale_srv"),
	function(b, a)
		if a == "toggle" then
			C.scaleUseServer = not C.scaleUseServer
			if C.scaleUseServer then
				S.notify((S.lang=="ru" and "Серверные методы ВКЛ — эксперимент" or "Server methods ON — experimental"),
					Color3.fromRGB(255,180,80))
			end
		end
		if C.scaleUseServer then
			b.BackgroundColor3 = Color3.fromRGB(200,80,0)
			b.Text = t("scale_srv")..": "..t("on")
		else
			b.BackgroundColor3 = Color3.fromRGB(50,50,50)
			b.Text = t("scale_srv")..": "..t("off")
		end
	end,
	false, "scaleUseServer")

addR("Visual",
	t("scale_hook"),
	function(b, a)
		if a == "toggle" then
			if not hookAvailable() then
				S.notify(t("hook_no_support"), Color3.fromRGB(255,80,80))
			else
				C.scaleUseHook = not C.scaleUseHook
				if C.scaleUseHook then
					local ok = enableHook()
					if ok then
						S.notify(t("hook_on"), Color3.fromRGB(255,180,80))
					else
						C.scaleUseHook = false
						S.notify(t("hook_no_support"), Color3.fromRGB(255,80,80))
					end
				else
					disableHook()
					S.notify(t("hook_off"), Color3.fromRGB(120,180,255))
				end
			end
		end
		if C.scaleUseHook then
			b.BackgroundColor3 = Color3.fromRGB(180,0,120)
			b.Text = t("scale_hook")..": "..t("on")
		else
			b.BackgroundColor3 = Color3.fromRGB(50,50,50)
			b.Text = t("scale_hook")..": "..t("off")
		end
	end,
	false, "scaleUseHook")

S._resetScale = function()
	C.scaleEn = false
	S.delT("UCS_ScaleSync")
	resetScale()
	if C._hookActive then disableHook() end
end

LP.CharacterAdded:Connect(function(c)
	task.wait(1.2)
	if C.scaleEn then
		local hum = c:WaitForChild("Humanoid", 5)
		if hum then
			C._scaleOriginalDesc = nil
			C._lastScaleToValue = nil
			task.defer(applyScale)
		end
	end
end)

onLangChange(function()
	local tb = S.toggles.scaleEn and S.toggles.scaleEn.btn
	if tb and tb.Parent then
		tb.Text = t("scale")..": "..(C.scaleEn and t("on") or t("off")).." ("..string.format("%.1f", C.scaleValue)..")"
	end
	local tb2 = S.toggles.scaleUseServer and S.toggles.scaleUseServer.btn
	if tb2 and tb2.Parent then
		tb2.Text = t("scale_srv")..": "..(C.scaleUseServer and t("on") or t("off"))
	end
	local tb3 = S.toggles.scaleUseHook and S.toggles.scaleUseHook.btn
	if tb3 and tb3.Parent then
		tb3.Text = t("scale_hook")..": "..(C.scaleUseHook and t("on") or t("off"))
	end
end)

-- ============================================================
-- SEARCH + STARS
-- ============================================================
local funRows = {}
local rowOrder = {}

local function fixTabOrder(tab)
	local lay = tab:FindFirstChildOfClass("UIListLayout")
	if lay then lay.SortOrder = Enum.SortOrder.LayoutOrder end
	local idx = 0
	for _, child in ipairs(tab:GetChildren()) do
		if child.Name ~= "UCS_SearchBox" and child.Name ~= "ACE_SearchBox" and child:IsA("GuiObject") then
			local ok = pcall(function() return child.LayoutOrder end)
			if ok then
				idx = idx + 1
				rowOrder[child] = idx
				child.LayoutOrder = idx
			end
		end
	end
end

local function indexRows()
	funRows = {}
	rowOrder = {}
	for _, tabName in ipairs({"Main","Func","Visual","WP","Addons","Settings"}) do
		local tab = S.Tabs[tabName]
		if tab then
			fixTabOrder(tab)
			for _, child in ipairs(tab:GetChildren()) do
				if child:IsA("Frame") then
					for k, tg in pairs(S.toggles) do
						if tg.btn and tg.btn.Parent == child then
							funRows[child] = k
							break
						end
					end
				end
			end
		end
	end
end

local function reorderAll()
	local favs = getFavs()
	local favIdx = 0
	for row, key in pairs(funRows) do
		if row and row.Parent then
			if favs[key] then
				favIdx = favIdx + 1
				row.LayoutOrder = -10000 + favIdx
			else
				row.LayoutOrder = rowOrder[row] or 99999
			end
		end
	end
end

local function addStar(row, key)
	if row:FindFirstChild("UCS_FavStar") then return end
	local mainBtn, sldMinus, sldPlus = nil, nil, nil
	for _, c in ipairs(row:GetChildren()) do
		if c:IsA("TextButton") and c.Name ~= "UCS_FavStar" then
			if not mainBtn then mainBtn = c
			elseif not sldMinus then sldMinus = c
			else sldPlus = c end
		end
	end
	if not mainBtn then return end

	if sldPlus then
		mainBtn.Size = UDim2.new(1, -88, 1, 0)
		sldMinus.Size = UDim2.new(0, 25, 1, 0); sldMinus.Position = UDim2.new(1, -86, 0, 0)
		sldPlus.Size = UDim2.new(0, 25, 1, 0);  sldPlus.Position = UDim2.new(1, -58, 0, 0)
	else
		mainBtn.Size = UDim2.new(1, -32, 1, 0)
	end

	local star = Instance.new("TextButton", row)
	star.Name = "UCS_FavStar"
	star.Size = UDim2.new(0, 26, 1, 0)
	star.Position = UDim2.new(1, -28, 0, 0)
	star.BackgroundColor3 = Color3.fromRGB(60,60,60)
	star.BorderSizePixel = 0
	star.Text = "☆"
	star.TextColor3 = Color3.fromRGB(255,220,80)
	star.Font = Enum.Font.SourceSansBold
	star.TextSize = 14
	star.ZIndex = 5
	Instance.new("UICorner", star).CornerRadius = UDim.new(0,4)
	local function refreshStar()
		local favs = getFavs()
		if favs[key] then
			star.Text = "★"; star.BackgroundColor3 = Color3.fromRGB(180,140,20)
		else
			star.Text = "☆"; star.BackgroundColor3 = Color3.fromRGB(60,60,60)
		end
	end
	refreshStar()
	star.MouseButton1Click:Connect(function()
		toggleFav(key); refreshStar(); reorderAll()
	end)
end

local function addSearchToTab(tabName)
	local tab = S.Tabs[tabName]
	if not tab or tab:FindFirstChild("UCS_SearchBox") then return end
	local box = Instance.new("TextBox", tab)
	box.Name = "UCS_SearchBox"
	box.Size = UDim2.new(1, -5, 0, 28)
	box.BackgroundColor3 = Color3.fromRGB(45,45,45)
	box.BorderSizePixel = 0
	box.PlaceholderText = t("search_ph")
	box.Text = ""
	box.TextColor3 = Color3.new(1,1,1)
	box.PlaceholderColor3 = Color3.fromRGB(140,140,140)
	box.Font = Enum.Font.SourceSansBold
	box.TextSize = 11
	box.ClearTextOnFocus = false
	box.LayoutOrder = -99999
	Instance.new("UICorner", box).CornerRadius = UDim.new(0,4)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local q = string.lower(box.Text or "")
		for row, _ in pairs(funRows) do
			if row and row.Parent == tab then
				local mainBtn = nil
				for _, c in ipairs(row:GetChildren()) do
					if c:IsA("TextButton") and c.Name ~= "UCS_FavStar" then mainBtn = c; break end
				end
				if mainBtn then
					local txt = string.lower(mainBtn.Text or "")
					row.Visible = (q == "") or (string.find(txt, q, 1, true) ~= nil)
				end
			end
		end
	end)
end

task.spawn(function()
	task.wait(0.7)
	indexRows()
	for _, tabName in ipairs({"Main","Func","Visual","WP","Addons","Settings"}) do
		addSearchToTab(tabName)
	end
	for row, key in pairs(funRows) do
		if row and row.Parent then addStar(row, key) end
	end
	reorderAll()
	local n = 0
	for _ in pairs(funRows) do n = n + 1 end
	print(t("search_ready")..n)
end)

onLangChange(function()
	for _, tabName in ipairs({"Main","Func","Visual","WP","Addons","Settings"}) do
		local tab = S.Tabs[tabName]
		if tab then
			local box = tab:FindFirstChild("UCS_SearchBox")
			if box then box.PlaceholderText = t("search_ph") end
		end
	end
end)

S._extrasCleanup = function()
	if S._setFreecam and C.freecam then S._setFreecam(false) end
	if S._resetScale then pcall(S._resetScale) end
	if C._hookActive then disableHook() end
	if ipConn then ipConn:Disconnect() end
	if S._freeButtons then
		for _,b in ipairs(S._freeButtons) do pcall(function() b:Destroy() end) end
	end
	if infoPanel then infoPanel:Destroy() end
	if hkPanel then hkPanel:Destroy() end
end

print(t("done"))
