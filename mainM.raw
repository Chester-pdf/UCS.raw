print("[UCS] mainM start v1.4.1")
if _G.UCS_Unload then pcall(_G.UCS_Unload) end
_G.UCS = nil
_G._UCS_AddLoaded = nil
task.wait(0.1)

local Players=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local RS=game:GetService("RunService")
local Lighting=game:GetService("Lighting")
local Tween=game:GetService("TweenService")
local Http=game:GetService("HttpService")
local LP=Players.LocalPlayer
local Cam=workspace.CurrentCamera
local S={}
_G.UCS=S

-- ===== LANG =====
S.lang = _G.UCS_PresetLang or "en"
local L = {
	ru = {
		tab_main="ДВИЖ", tab_func="ФУНК", tab_vis="ВИЗ", tab_play="ИГРОК",
		tab_wp="ТОЧКИ", tab_addons="АДДОНЫ", tab_settings="⚙",
		run="Бег", fly="Полёт", jump="Прыжок", infjump="Беск. Прыжок",
		autojump="Авто-Прыжок",
		noclip="Ноуклип", platform="Платформа", hotkeys_work="Хоткеи: работа",
		hotkeys_move="Хоткеи: перемещение", respawn="Респавн себя",
		freeze_player="Заморозить игрока",
		freeze_cam="Заморозить камеру",
		on="ВКЛ", off="ВЫКЛ",
		fastint="Фаст Интеракт", fi_safe="FastInteract: Безопасно",
		antiragdoll="Анти-Рэгдолл",
		antivoid="Анти-Войд",
		espp="ESP игроки", espnpc="ESP NPC", xray="X-Ray", fullbright="Фуллбрайт",
		nofog="Убрать туман", fov="Угол обзора (FOV)",
		search_players="Поиск: имя или @username",
		spectate="СМОТР", stop="СТОП", hide="СКРЫТЬ", show="ПОКАЗ",
		wp_name_ph="Имя (пусто = авто)", wp_save="Сохранить позицию",
		wp_clear="Удалить все",
		addon_url_ph="URL raw-скрипта", addon_name_ph="Имя аддона",
		addon_add="Добавить аддон", addon_clear="Очистить список",
		addon_empty="Список пуст.",
	if not ok or not remote then return end
	remote = tostring(remote):gsub("%s+$",""):gsub("^%s+","")
	if remote == "" or remote == S.VERSION then return end
	local function vnum(s)
		local a,b,c = tostring(s):match("^(%d+)%.(%d+)%.?(%d*)")
		return (tonumber(a) or 0)*10000 + (tonumber(b) or 0)*100 + (tonumber(c) or 0)
	end
	if vnum(remote) > vnum(S.VERSION) then
		S.notify(t("n_update")..remote..t("n_update_you")..S.VERSION..")", Color3.fromRGB(255,200,80))
		if S._watermark and S._watermark.Parent then
			S._watermark.Text = "UCS v"..S.VERSION.."  →  v"..remote.."  ·  "..S.AUTHOR
			S._watermark.TextColor3 = Color3.fromRGB(255,220,100)
			S._watermark.TextTransparency = 0
		end
	end
end)

_G.UCS_Unload=function()
	for k in pairs(S.conns) do S.dis(k) end
	for n in pairs(S.tasks) do S.delT(n) end
	for url in pairs(runningAddons) do
		pcall(function() stopAddon(url) end)
	end
	if S._extrasCleanup then pcall(S._extrasCleanup) end
	if S.stopPlat then pcall(S.stopPlat) end
	if S.clearNH then pcall(S.clearNH) end
	if S.clearXray then pcall(S.clearXray) end
	S.dis("FreezePlayer"); S.dis("FreezeCam")
	if stealthTrigger then pcall(function() stealthTrigger:Destroy() end) end
	if customJumpBtn then pcall(function() customJumpBtn:Destroy() end) end
	pcall(function() UIS.MouseBehavior=Enum.MouseBehavior.Default; Cam.CameraType=Enum.CameraType.Custom end)
	pcall(function() S.col(LP.Character,true) end)
	local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if h then h.PlatformStand=false; h.WalkSpeed=16 end
	pcall(function() if S.plat then S.plat:Destroy() end end)
	pcall(function() if S.SG then S.SG:Destroy() end end)
	_G.UCS_Unload=nil
	print("[UCS] Unloaded")
end

S.notify(t("n_ucs_loaded"),Color3.fromRGB(0,200,0))
print("[UCS] DONE")
