local function t(k)
	local tbl = L[S.lang] or L.en
	return tbl[k] or (L.en[k]) or k
end
S.t = t

-- ===== LIVE LANG =====
S._langListeners = {}
S._langRefs = {}
S.tabButtons = {}
function S.onLangChange(fn) table.insert(S._langListeners, fn) end
function S.langRef(obj, prop, keyOrFn)
	table.insert(S._langRefs, {obj=obj, prop=prop, key=keyOrFn})
end
function S.fireLangChange()
	for _,fn in ipairs(S._langListeners) do pcall(fn) end
end
function S.refreshLang()
	for _,r in ipairs(S._langRefs) do
		if r.obj and r.obj.Parent then
			local txt = (type(r.key)=="function") and r.key() or t(r.key)
			pcall(function() r.obj[r.prop] = txt end)
		end
	end
	if S.tabButtons and S._tabLabelKeys then
		for n, b in pairs(S.tabButtons) do
			if b and b.Parent and S._tabLabelKeys[n] then
				pcall(function() b.Text = t(S._tabLabelKeys[n]) end)
			end
		end
	end
	for _, tg in pairs(S.toggles) do
		if tg.btn and tg.cb then pcall(tg.cb, tg.btn, "refresh") end
	end
	S.fireLangChange()
end

