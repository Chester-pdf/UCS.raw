S.conns.Respawn=LP.CharacterAdded:Connect(function(ch)
	task.wait(1)
	if C.nEn then task.spawn(function() while C.nEn and ch.Parent do S.col(ch,false); task.wait() end end) end
	if C.arEn and S.applyAR then S.applyAR(ch) end
	if C.fEn and S.stopFly then S.stopFly(); C.fEn=false end
	if C.platEn and S.startPlat then task.wait(0.5); S.startPlat() end
	if C.xrayEn then task.wait(0.2)
		for _,o in ipairs(ch:GetDescendants()) do if o:IsA("BasePart") then pcall(function() o.LocalTransparencyModifier=0 end) end end
	end
end)

S.conns.Hotkeys=UIS.InputBegan:Connect(function(i,gp)
	if gp then return end
	if i.KeyCode==Enum.KeyCode.F and S.toggleFly then S.toggleFly() end
	if i.KeyCode==Enum.KeyCode.N then
		C.nEn=not C.nEn
		if C.nEn then
			S.conns.Noclip=RS.PreSimulation:Connect(function() S.col(LP.Character,false) end)
		else S.dis("Noclip"); S.col(LP.Character,true) end
		if S.toggles.nEn then
			local tb=S.toggles.nEn.btn
			if C.nEn then tb.Text=t("noclip")..": "..t("on"); tb.BackgroundColor3=Color3.fromRGB(0,120,0)
			else tb.Text=t("noclip")..": "..t("off"); tb.BackgroundColor3=Color3.fromRGB(50,50,50) end
		end
	end
	if i.KeyCode==Enum.KeyCode.C then
		C.platEn=not C.platEn
		if C.platEn then S.startPlat() else S.stopPlat() end
		if S.toggles.platEn then
			local tb=S.toggles.platEn.btn
			if C.platEn then tb.Text=t("platform")..": "..t("on"); tb.BackgroundColor3=Color3.fromRGB(0,120,0)
			else tb.Text=t("platform")..": "..t("off"); tb.BackgroundColor3=Color3.fromRGB(50,50,50) end
		end
	end
	if i.KeyCode==Enum.KeyCode.V and S.toggleFreezePlayer then S.toggleFreezePlayer() end
	if i.KeyCode==Enum.KeyCode.B and S.toggleFreezeCam then S.toggleFreezeCam() end
	if i.KeyCode==Enum.KeyCode.LeftControl and S.doDash then S.doDash() end
	if i.KeyCode==Enum.KeyCode.R and UIS:IsKeyDown(Enum.KeyCode.LeftAlt) then if S.doRespawn then S.doRespawn() end end
	if i.KeyCode==Enum.KeyCode.RightShift then
		if S.MF.Visible then S.MF.Visible=false; if S.Op then S.Op.Visible=true end
		else S.MF.Visible=true; if S.Op then S.Op.Visible=false end end
	end
end)

task.spawn(function()
	local url = "https://raw.githubusercontent.com/Chester-pdf/USC.raw/main/add.raw?t=" .. tostring(tick())
	local ok, src = pcall(game.HttpGet, game, url)
	if ok and src and #src > 500 then
		local fn, err = loadstring(src)
		if fn then
			local ok2, err2 = pcall(fn)
			if not ok2 then warn("[UCS add] "..tostring(err2)) end
		end
	end
end)

-- ============================================================
-- CHANGELOG
-- ============================================================
do
	local CHANGELOG_FILE = "UCS_ChangelogCache.json"
	local CHANGELOG_SEEN = "UCS_ChangelogSeen.json"
	local changelogData = {entries={}}
	local seenVersions = {}

	pcall(function()
		if isfile and isfile(CHANGELOG_FILE) then
			local d = Http:JSONDecode(readfile(CHANGELOG_FILE))
			if type(d)=="table" and type(d.entries)=="table" then changelogData=d end
		end
		if isfile and isfile(CHANGELOG_SEEN) then
			local d2 = Http:JSONDecode(readfile(CHANGELOG_SEEN))
			if type(d2)=="table" then seenVersions=d2 end
		end
	end)
	local function saveChangelogCache() pcall(function() writefile(CHANGELOG_FILE, Http:JSONEncode(changelogData)) end) end
	local function saveSeen() pcall(function() writefile(CHANGELOG_SEEN, Http:JSONEncode(seenVersions)) end) end

	local function fetchChangelog()
		if not S.CHANGELOG_URL then return false end
		local ok, src = pcall(function() return game:HttpGet(S.CHANGELOG_URL.."?t="..tostring(tick()), true) end)
		if not ok or not src or #src < 20 then return false end
		local ok2, d = pcall(function() return Http:JSONDecode(src) end)
		if not ok2 or type(d)~="table" or type(d.entries)~="table" then return false end
		changelogData = d
		saveChangelogCache()
		return true
	end

	local function unseenCount()
		local n = 0
		for _,e in ipairs(changelogData.entries or {}) do
			if e.version and not seenVersions[e.version] then n = n + 1 end
		end
		return n
	end

	local function markAllSeen()
		for _,e in ipairs(changelogData.entries or {}) do
			if e.version then seenVersions[e.version] = true end
		end
		saveSeen()
	end

	local function tcl(k)
		local tbl = (L[S.lang] or L.en)
		if tbl and tbl[k] then return tbl[k] end
		return k
	end

	local clBtnRow = Instance.new("TextButton", S.Tabs.Settings)
	clBtnRow.Name = "UCS_ChangelogBtn"
	clBtnRow.Size = UDim2.new(1,-5,0,32)
	clBtnRow.BackgroundColor3 = Color3.fromRGB(60,40,90)
	clBtnRow.BorderSizePixel = 0
	clBtnRow.Text = tcl("whats_new")
	clBtnRow.TextColor3 = Color3.new(1,1,1)
	clBtnRow.Font = Enum.Font.SourceSansBold
	clBtnRow.TextSize = 12
	clBtnRow.LayoutOrder = 9999
	Instance.new("UICorner", clBtnRow).CornerRadius = UDim.new(0,4)

	local CLPanel = Instance.new("Frame", SG)
	CLPanel.Name = "UCS_ChangelogPanel"
	CLPanel.Size = UDim2.new(0, 320, 0, 400)
	CLPanel.Position = UDim2.new(0.5, -160, 0.5, -200)
	CLPanel.BackgroundColor3 = Color3.fromRGB(22,22,28)
	CLPanel.BorderSizePixel = 0
	CLPanel.Visible = false
	CLPanel.ZIndex = 100
	Instance.new("UICorner", CLPanel).CornerRadius = UDim.new(0,8)
	Instance.new("UIStroke", CLPanel).Color = Color3.fromRGB(180,140,255)

	local clTitle = Instance.new("TextLabel", CLPanel)
	clTitle.Size = UDim2.new(1,0,0,28)
	clTitle.BackgroundColor3 = Color3.fromRGB(42,42,42)
	clTitle.BorderSizePixel = 0
	clTitle.Text = tcl("changelog_title")
	clTitle.TextColor3 = Color3.fromRGB(180,140,255)
	clTitle.Font = Enum.Font.SourceSansBold
	clTitle.TextSize = 12
	Instance.new("UICorner", clTitle).CornerRadius = UDim.new(0,8)

	local clClose = Instance.new("TextButton", CLPanel)
	clClose.Size = UDim2.new(0,28,0,28)
	clClose.Position = UDim2.new(1,-28,0,0)
	clClose.BackgroundTransparency = 1
	clClose.Text = "×"
	clClose.TextColor3 = Color3.new(1,1,1)
	clClose.Font = Enum.Font.SourceSansBold
	clClose.TextSize = 16

	local clScroll = Instance.new("ScrollingFrame", CLPanel)
	clScroll.Size = UDim2.new(1,-16,1,-40)
	clScroll.Position = UDim2.new(0,8,0,34)
	clScroll.BackgroundTransparency = 1
	clScroll.BorderSizePixel = 0
	clScroll.ScrollBarThickness = 4
	clScroll.ScrollBarImageColor3 = Color3.fromRGB(180,140,255)
	clScroll.CanvasSize = UDim2.new(0,0,0,0)
	clScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Instance.new("UIListLayout", clScroll).Padding = UDim.new(0,6)

	local function renderChangelog()
		for _,c in ipairs(clScroll:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		local list = changelogData.entries or {}
		if #list == 0 then
			local lbl = Instance.new("TextLabel", clScroll)
			lbl.Size = UDim2.new(1,-5,0,30)
			lbl.BackgroundTransparency = 1
			lbl.Text = tcl("changelog_empty")
			lbl.TextColor3 = Color3.fromRGB(140,140,140)
			lbl.Font = Enum.Font.SourceSansBold
			lbl.TextSize = 11
			return
		end
		for _,e in ipairs(list) do
			local isNew = e.version and not seenVersions[e.version]
			local card = Instance.new("Frame", clScroll)
			card.Size = UDim2.new(1,-5,0,0)
			card.AutomaticSize = Enum.AutomaticSize.Y
			card.BackgroundColor3 = isNew and Color3.fromRGB(45,35,60) or Color3.fromRGB(36,36,42)
			card.BorderSizePixel = 0
			Instance.new("UICorner", card).CornerRadius = UDim.new(0,6)
			local pad = Instance.new("UIPadding", card)
			pad.PaddingTop = UDim.new(0,8); pad.PaddingBottom = UDim.new(0,8)
			pad.PaddingLeft = UDim.new(0,10); pad.PaddingRight = UDim.new(0,10)
			local lay = Instance.new("UIListLayout", card)
			lay.Padding = UDim.new(0,4)
			lay.SortOrder = Enum.SortOrder.LayoutOrder

			local header = Instance.new("Frame", card)
			header.Size = UDim2.new(1,0,0,18)
			header.BackgroundTransparency = 1
			header.LayoutOrder = 1

			local vLabel = Instance.new("TextLabel", header)
			vLabel.Size = UDim2.new(0,80,1,0)
			vLabel.BackgroundTransparency = 1
			vLabel.Text = "v"..tostring(e.version or "?")
			vLabel.TextColor3 = Color3.fromRGB(255,180,80)
			vLabel.Font = Enum.Font.SourceSansBold; vLabel.TextSize = 12
			vLabel.TextXAlignment = Enum.TextXAlignment.Left

			local dLabel = Instance.new("TextLabel", header)
			dLabel.Size = UDim2.new(1,-80,1,0); dLabel.Position = UDim2.new(0,80,0,0)
			dLabel.BackgroundTransparency = 1
			dLabel.Text = tostring(e.date or "")
			dLabel.TextColor3 = Color3.fromRGB(150,150,150)
			dLabel.Font = Enum.Font.SourceSans; dLabel.TextSize = 10
			dLabel.TextXAlignment = Enum.TextXAlignment.Right

			if isNew then
				local badge = Instance.new("TextLabel", header)
				badge.Size = UDim2.new(0,52,0,16)
				badge.Position = UDim2.new(1,-132,0,1)
				badge.BackgroundColor3 = Color3.fromRGB(180,120,255)
				badge.BorderSizePixel = 0
				badge.Text = tcl("changelog_new_badge")
				badge.TextColor3 = Color3.new(1,1,1)
				badge.Font = Enum.Font.SourceSansBold; badge.TextSize = 8
				Instance.new("UICorner", badge).CornerRadius = UDim.new(0,4)
			end

			local changes = (e.changes and (e.changes[S.lang] or e.changes.en)) or {}
			for _,line in ipairs(changes) do
				local bullet = Instance.new("TextLabel", card)
				bullet.Size = UDim2.new(1,0,0,0)
				bullet.AutomaticSize = Enum.AutomaticSize.Y
				bullet.BackgroundTransparency = 1
				bullet.Text = "•  "..tostring(line)
				bullet.TextColor3 = Color3.fromRGB(220,220,220)
				bullet.Font = Enum.Font.SourceSans; bullet.TextSize = 11
				bullet.TextXAlignment = Enum.TextXAlignment.Left
				bullet.TextWrapped = true
				bullet.LayoutOrder = 2
			end
		end
	end

	local function refreshClButton()
		local n = unseenCount()
		if n > 0 then
			clBtnRow.Text = tcl("whats_new").."  ("..n..")"
			clBtnRow.BackgroundColor3 = Color3.fromRGB(120,80,180)
		else
			clBtnRow.Text = tcl("whats_new")
			clBtnRow.BackgroundColor3 = Color3.fromRGB(60,40,90)
		end
	end

	clBtnRow.MouseButton1Click:Connect(function()
		if not CLPanel.Visible then
			renderChangelog()
			CLPanel.Visible = true
			markAllSeen()
			task.defer(refreshClButton)
		else
			CLPanel.Visible = false
		end
	end)
	clClose.MouseButton1Click:Connect(function() CLPanel.Visible = false end)

	refreshClButton()

	task.spawn(function()
		task.wait(2)
		if fetchChangelog() then refreshClButton() end
	end)

	if S.onLangChange then
		S.onLangChange(function()
			pcall(function() clTitle.Text = tcl("changelog_title") end)
			refreshClButton()
			if CLPanel.Visible then renderChangelog() end
		end)
	end
	print("[UCS] Changelog ok")
end

task.spawn(function()
	task.wait(3)
	local ok, remote = pcall(function()
		return game:HttpGet(S.VERSION_URL.."?t="..tostring(tick()), true)
	end)
	if not ok or not remote then return end
	remote = tostring(remote):gsub("%s+$",""):gsub("^%s+","")
	if remote == "" or remote == S.VERSION then return end
	local function vnum(s)
		local a,b,c = tostring(s):match("^(%d+)%.(%d+)%.?(%d*)")
		return (tonumber(a) or 0)*10000 + (tonumber(b) or 0)*100 + (tonumber(c) or 0)
	end
	if vnum(remote) > vnum(S.VERSION) then
		S.notify(t("n_update")..remote..t("n_update_you")..S.VERSION..")",
			Color3.fromRGB(255,200,80))
		if S._watermark and S._watermark.Parent then
			S._watermark.Text = "UCS v"..S.VERSION.."  →  v"..remote.."  ·  "..S.AUTHOR
			S._watermark.TextColor3 = Color3.fromRGB(255,220,100)
			S._watermark.TextTransparency = 0
		end
	end
end)

_G.UCS_Unload=function()
	for k in pairs(S.conns) do S.dis(k) end
	for n in pairs(S.tasks) do S.delT(n) end
	if S._extrasCleanup then pcall(S._extrasCleanup) end
	if S.stopPlat then pcall(S.stopPlat) end
	if S.clearNH then pcall(S.clearNH) end
	if S.clearXray then pcall(S.clearXray) end
	S.dis("FreezePlayer"); S.dis("FreezeCam")
	if stealthTrigger then pcall(function() stealthTrigger:Destroy() end) end
	pcall(function() UIS.MouseBehavior=Enum.MouseBehavior.Default; Cam.CameraType=Enum.CameraType.Custom end)
	pcall(function() S.col(LP.Character,true) end)
	local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if h then h.PlatformStand=false; h.WalkSpeed=16 end
	pcall(function() if S.plat then S.plat:Destroy() end end)
	pcall(function() if S.SG then S.SG:Destroy() end end)
	_G.UCS_Unload=nil
	print("[UCS] Unloaded")
end
S.notify(t("n_ucs_loaded"),Color3.fromRGB(0,200,0))
print("[UCS] DONE")
