function S.enterStealth()
	C.stealthHidden=true
	pcall(function() MF.Visible=false end)
	pcall(function() Op.Visible=false end)
	ensureStealth()
	S.notify(t("n_stealth_on"),Color3.fromRGB(120,200,255))
end
function S.exitStealth()
	C.stealthHidden=false
	if MF.Position.X.Offset<=-9000 then MF.Position=UDim2.new(0.5,-145,0.5,-188) end
	MF.Visible=true; Op.Visible=false
	if stealthTrigger then pcall(function() stealthTrigger:Destroy() end); stealthTrigger=nil end
	S.notify(t("n_stealth_off"),Color3.fromRGB(120,200,255))
end
StealthBtn.MouseButton1Click:Connect(function() S.enterStealth() end)

-- ============ MAIN ============
local function applySpd(_,reset)
	pcall(function()
		local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if h then h.WalkSpeed=reset and 16 or C.tSp end
	end)
end
addR("Main",t("run").." ("..C.tSp..")",function(b,a)
	if a=="toggle" then C.sEn=not C.sEn
		if C.sEn then b.BackgroundColor3=Color3.fromRGB(0,120,0); S.addT("Speed",applySpd,0.1); applySpd()
		else b.BackgroundColor3=Color3.fromRGB(50,50,50); S.delT("Speed"); applySpd(nil,true) end
	elseif a=="minus" then C.tSp=C.tSp-10; if C.sEn then applySpd() end
	elseif a=="plus" then C.tSp=C.tSp+10; if C.sEn then applySpd() end end
	b.Text=t("run")..": "..(C.sEn and t("on") or t("off")).." ("..C.tSp..")"
end,true,"sEn","tSp")

local flyBV
local function startFly()
	local char=LP.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	local hum=char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then C.fEn=false; return end
	hum.PlatformStand=true
	if flyBV and flyBV.Parent then flyBV:Destroy() end
	flyBV=Instance.new("BodyPosition",root); flyBV.Name="UcsFlyPos"
	flyBV.MaxForce=Vector3.new(9e9,9e9,9e9); flyBV.Position=root.Position
	pcall(function()
		if fiHoldSaved[o]~=nil then o.HoldDuration=fiHoldSaved[o] end
		if fiLosSaved[o]~=nil then o.RequiresLineOfSight=fiLosSaved[o] end
	end)
	fiHoldSaved[o]=nil; fiLosSaved[o]=nil
end
local function fiAdd(o)
	if o:IsA("ProximityPrompt") then promptCache[o]=o; if C.fiEn then fiApplyPrompt(o) end
	elseif o:IsA("ClickDetector") then clickCache[o]=o end
end
local function fiRm(o) promptCache[o]=nil; clickCache[o]=nil; fiHoldSaved[o]=nil; fiLosSaved[o]=nil end
for _,o in ipairs(workspace:GetDescendants()) do fiAdd(o) end
S.conns.FI_Add=workspace.DescendantAdded:Connect(function(o)
	if o:IsA("ProximityPrompt") or o:IsA("ClickDetector") then
		task.defer(function() if o.Parent then fiAdd(o) end end)
	end
end)
S.conns.FI_Rem=workspace.DescendantRemoving:Connect(function(o)
	if o:IsA("ProximityPrompt") or o:IsA("ClickDetector") then fiRm(o) end
end)
local FI_P=(typeof(fireproximityprompt)=="function")
local FI_C=(typeof(fireclickdetector)=="function")
local function doFastInteract()
	local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local pos=root.Position; local rad=C.fiRange
	if FI_P then
		for o in pairs(promptCache) do
			if not o.Parent then promptCache[o]=nil; fiHoldSaved[o]=nil; fiLosSaved[o]=nil
			elseif o.Enabled then
				local part=o.Parent
				if part and part:IsA("BasePart") and (part.Position-pos).Magnitude<=rad then
					pcall(fireproximityprompt,o)
				end
			end
		end
	end
	if FI_C then
		for o in pairs(clickCache) do
			if not o.Parent then clickCache[o]=nil
			else
				local part=o.Parent
				if part and part:IsA("BasePart") and (part.Position-pos).Magnitude<=rad then
					pcall(fireclickdetector,o)
if wpClear and wpClear.Parent then wpClear.Parent.LayoutOrder=3 end
local WPlf=Instance.new("Frame",S.Tabs.WP)
WPlf.Size=UDim2.new(1,-5,0,0); WPlf.AutomaticSize=Enum.AutomaticSize.Y
WPlf.BackgroundTransparency=1; WPlf.LayoutOrder=4
Instance.new("UIListLayout",WPlf).Padding=UDim.new(0,4)
local function refreshWP()
	for _,c in ipairs(WPlf:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	local sorted={}
	for name in pairs(waypoints) do sorted[#sorted+1]=name end
	table.sort(sorted,function(a,b)
		local na=tonumber(a); local nb=tonumber(b)
		if na and nb then return na<nb end
		if na then return true end
		if nb then return false end
		return a<b
	end)
	for _,name in ipairs(sorted) do
		local pos=waypoints[name]
		local row=Instance.new("Frame",WPlf); row.Size=UDim2.new(1,0,0,30)
		row.BackgroundColor3=Color3.fromRGB(50,50,50); row.BorderSizePixel=0
		Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
		local lbl=Instance.new("TextLabel",row)
		lbl.Size=UDim2.new(1,-90,1,0); lbl.Position=UDim2.new(0,6,0,0)
		lbl.BackgroundTransparency=1; lbl.Text=name; lbl.TextColor3=Color3.new(1,1,1)
		lbl.Font=Enum.Font.SourceSansBold; lbl.TextSize=11
		lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.TextTruncate=Enum.TextTruncate.AtEnd
		local tp=Instance.new("TextButton",row)
		tp.Size=UDim2.new(0,38,1,-4); tp.Position=UDim2.new(1,-84,0,2)
		tp.BackgroundColor3=Color3.fromRGB(0,120,180); tp.BorderSizePixel=0
		tp.Text="TP"; tp.TextColor3=Color3.new(1,1,1); tp.Font=Enum.Font.SourceSansBold; tp.TextSize=11
		Instance.new("UICorner",tp).CornerRadius=UDim.new(0,3)
		local del=Instance.new("TextButton",row)
		del.Size=UDim2.new(0,38,1,-4); del.Position=UDim2.new(1,-42,0,2)
		del.BackgroundColor3=Color3.fromRGB(150,40,40); del.BorderSizePixel=0
		del.Text="X"; del.TextColor3=Color3.new(1,1,1); del.Font=Enum.Font.SourceSansBold; del.TextSize=12
		Instance.new("UICorner",del).CornerRadius=UDim.new(0,3)
		tp.MouseButton1Click:Connect(function()
			local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			if not root then return end
			S.skipTPNow(1)
			root.Velocity=Vector3.zero
			root.CFrame=CFrame.new(pos.x,pos.y+3,pos.z)
		end)
		del.MouseButton1Click:Connect(function() waypoints[name]=nil; saveWP(); refreshWP() end)
local CATEGORY_LABEL = {
	combat = "⚔ Бой", movement = "🏃 Движение", visual = "👁 Визуал",
	utility = "🔧 Утилиты", custom = "📦 Свои", other = "• Прочее",
}

local function refreshAddons()
	for _,c in ipairs(ALf:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	local list = getMergedAddons()
	if #list == 0 then
		local empty=Instance.new("Frame",ALf); empty.Size=UDim2.new(1,0,0,40); empty.BackgroundTransparency=1
		local lbl=Instance.new("TextLabel",empty); lbl.Size=UDim2.new(1,0,1,0); lbl.BackgroundTransparency=1
		lbl.Text=t("addon_empty"); lbl.TextColor3=Color3.fromRGB(140,140,140)
		lbl.Font=Enum.Font.SourceSansBold; lbl.TextSize=11
		return
	end
	table.sort(list,function(x,y)
		local xi = table.find(CATEGORY_ORDER, x.category) or 99
		local yi = table.find(CATEGORY_ORDER, y.category) or 99
		if xi ~= yi then return xi < yi end
		return string.lower(x.name) < string.lower(y.name)
	end)

	local lastCat
	for _,a in ipairs(list) do
		if a.category ~= lastCat then
			lastCat = a.category
			local hdr = Instance.new("Frame", ALf)
			hdr.Size = UDim2.new(1, 0, 0, 20); hdr.BackgroundTransparency = 1
			local lbl = Instance.new("TextLabel", hdr)
			lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1
			lbl.Text = CATEGORY_LABEL[a.category] or a.category
			lbl.TextColor3 = Color3.fromRGB(255,180,80)
			lbl.Font = Enum.Font.SourceSansBold; lbl.TextSize = 11
			lbl.TextXAlignment = Enum.TextXAlignment.Left
		end

		local isRunning = runningAddons[a.url] ~= nil
		local upd = (not isRunning) and (a.source == "remote") and hasUpdate(a)
		local remembered = false
		do
			local info = addonStore.autoLoad and addonStore.autoLoad[a.url]
			if type(info) == "table" and info.places and info.places[game.PlaceId] then
				remembered = true
			vLabel.TextXAlignment = Enum.TextXAlignment.Left

			local dLabel = Instance.new("TextLabel", header)
			dLabel.Size = UDim2.new(1,-80,1,0); dLabel.Position = UDim2.new(0,80,0,0)
			dLabel.BackgroundTransparency = 1
			dLabel.Text = tostring(e.date or "")
			dLabel.TextColor3 = Color3.fromRGB(150,150,150)
			dLabel.Font = Enum.Font.SourceSans; dLabel.TextSize = 10
			dLabel.TextXAlignment = Enum.TextXAlignment.Right

			if isNew then
				local badge = Instance.new("TextLabel", header)
				badge.Size = UDim2.new(0,52,0,16); badge.Position = UDim2.new(1,-132,0,1)
				badge.BackgroundColor3 = Color3.fromRGB(180,120,255); badge.BorderSizePixel = 0
				badge.Text = tcl("changelog_new_badge")
				badge.TextColor3 = Color3.new(1,1,1)
				badge.Font = Enum.Font.SourceSansBold; badge.TextSize = 8
				Instance.new("UICorner", badge).CornerRadius = UDim.new(0,4)
			end

			local changes = (e.changes and (e.changes[S.lang] or e.changes.en)) or {}
			for _,line in ipairs(changes) do
				local bullet = Instance.new("TextLabel", card)
				bullet.Size = UDim2.new(1,0,0,0); bullet.AutomaticSize = Enum.AutomaticSize.Y
				bullet.BackgroundTransparency = 1
				bullet.Text = "•  "..tostring(line)
				bullet.TextColor3 = Color3.fromRGB(220,220,220)
				bullet.Font = Enum.Font.SourceSans; bullet.TextSize = 11
				bullet.TextXAlignment = Enum.TextXAlignment.Left
				bullet.TextWrapped = true
				bullet.LayoutOrder = 2
			end
		end
	end

	local function refreshClButton()
		local n = unseenCount()
		if n > 0 then
			clBtnRow.Text = tcl("whats_new").."  ("..n..")"
			clBtnRow.BackgroundColor3 = Color3.fromRGB(120,80,180)
		else
			clBtnRow.Text = tcl("whats_new")
			clBtnRow.BackgroundColor3 = Color3.fromRGB(60,40,90)
		end
	end)
	if not ok or not remote then return end
	remote = tostring(remote):gsub("%s+$",""):gsub("^%s+","")
	if remote == "" or remote == S.VERSION then return end
	local function vnum(s)
		local a,b,c = tostring(s):match("^(%d+)%.(%d+)%.?(%d*)")
		return (tonumber(a) or 0)*10000 + (tonumber(b) or 0)*100 + (tonumber(c) or 0)
	end
	if vnum(remote) > vnum(S.VERSION) then
		S.notify(t("n_update")..remote..t("n_update_you")..S.VERSION..")", Color3.fromRGB(255,200,80))
		if S._watermark and S._watermark.Parent then
			S._watermark.Text = "UCS v"..S.VERSION.."  →  v"..remote.."  ·  "..S.AUTHOR
			S._watermark.TextColor3 = Color3.fromRGB(255,220,100)
			S._watermark.TextTransparency = 0
		end
	end
end)

_G.UCS_Unload=function()
	for k in pairs(S.conns) do S.dis(k) end
	for n in pairs(S.tasks) do S.delT(n) end
	for url in pairs(runningAddons) do
		pcall(function() stopAddon(url) end)
	end
	if S._extrasCleanup then pcall(S._extrasCleanup) end
	if S.stopPlat then pcall(S.stopPlat) end
	if S.clearNH then pcall(S.clearNH) end
	if S.clearXray then pcall(S.clearXray) end
	S.dis("FreezePlayer"); S.dis("FreezeCam")
	if stealthTrigger then pcall(function() stealthTrigger:Destroy() end) end
	pcall(function() UIS.MouseBehavior=Enum.MouseBehavior.Default; Cam.CameraType=Enum.CameraType.Custom end)
	pcall(function() S.col(LP.Character,true) end)
	local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if h then h.PlatformStand=false; h.WalkSpeed=16 end
	pcall(function() if S.plat then S.plat:Destroy() end end)
	pcall(function() if S.SG then S.SG:Destroy() end end)
	_G.UCS_Unload=nil
	print("[UCS] Unloaded")
end

S.notify(t("n_ucs_loaded"),Color3.fromRGB(0,200,0))
print("[UCS] DONE")
