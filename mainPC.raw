local searchBox=Instance.new("TextBox",S.Tabs.Players)
searchBox.Size=UDim2.new(1,-5,0,30); searchBox.BackgroundColor3=Color3.fromRGB(45,45,45)
searchBox.BorderSizePixel=0; searchBox.Text=""
searchBox.PlaceholderText=t("search_players")
searchBox.TextColor3=Color3.new(1,1,1); searchBox.PlaceholderColor3=Color3.fromRGB(140,140,140)
searchBox.Font=Enum.Font.SourceSansBold; searchBox.TextSize=12
Instance.new("UICorner",searchBox).CornerRadius=UDim.new(0,4)

local PLf=Instance.new("Frame",S.Tabs.Players)
PLf.Size=UDim2.new(1,-5,0,0); PLf.Position=UDim2.new(0,0,0,35)
PLf.AutomaticSize=Enum.AutomaticSize.Y; PLf.BackgroundTransparency=1
Instance.new("UIListLayout",PLf).Padding=UDim.new(0,4)
local FAV_FILE="UCS_Favorites.json"
local favorites={}
local function saveFav() pcall(function() local e={}; for id,name in pairs(favorites) do e[tostring(id)]=name end; writefile(FAV_FILE,Http:JSONEncode(e)) end) end
local function loadFav() pcall(function() if isfile and isfile(FAV_FILE) then local d=Http:JSONDecode(readfile(FAV_FILE)); for id,name in pairs(d) do favorites[tonumber(id) or id]=name end end end) end
loadFav()
local hidden={}; local hideC={}
local function hideP(p)
	hidden[p]=true; local c=p.Character; if not c then return end
	for _,o in ipairs(c:GetDescendants()) do if o:IsA("BasePart") then o.LocalTransparencyModifier=1 end end
	if hideC[p] then hideC[p]:Disconnect() end
	hideC[p]=c.DescendantAdded:Connect(function(o) if hidden[p] and o:IsA("BasePart") then task.wait(0.05); if hidden[p] and o.Parent then o.LocalTransparencyModifier=1 end end end)
end
local function showP(p)
	hidden[p]=nil
	if hideC[p] then hideC[p]:Disconnect(); hideC[p]=nil end
	local c=p.Character; if not c then return end
	for _,o in ipairs(c:GetDescendants()) do if o:IsA("BasePart") then o.LocalTransparencyModifier=0 end end
end
local function getDisplay(p)
	if p.DisplayName and p.DisplayName~="" and p.DisplayName~=p.Name then return p.DisplayName end
	return nil
end
local function getLabel(p, isFav)
	local prefix = isFav and "* " or ""
	local dn = getDisplay(p)
	if dn then return prefix..dn.." (@"..p.Name..")" end
	return prefix..p.Name
end
local function matchQuery(p, q)
	if q=="" then return true end
	q=q:gsub("^@","")
	local dn=string.lower(p.DisplayName or "")
	local nm=string.lower(p.Name or "")
	return string.find(dn,q,1,true)~=nil or string.find(nm,q,1,true)~=nil
end
local function refreshP()
	for _,c in ipairs(PLf:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	local q=string.lower(searchBox.Text or "")
	local list={}
	for _,p in ipairs(Players:GetPlayers()) do
		if p~=LP and matchQuery(p,q) then list[#list+1]=p end
	end
	table.sort(list,function(a,b)
		local fa=favorites[a.UserId] and 1 or 0; local fb=favorites[b.UserId] and 1 or 0
		if fa~=fb then return fa>fb end
		return string.lower(a.Name)<string.lower(b.Name)
	end)
	for _,p in ipairs(list) do
		local isFav=favorites[p.UserId] and true or false
		local row=Instance.new("Frame",PLf); row.Size=UDim2.new(1,-5,0,30)
		row.BackgroundColor3=isFav and Color3.fromRGB(70,55,20) or Color3.fromRGB(50,50,50)
		row.BorderSizePixel=0
		Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
		local nm=Instance.new("TextLabel",row)
		nm.Size=UDim2.new(1,-165,1,0); nm.Position=UDim2.new(0,6,0,0)
		nm.BackgroundTransparency=1; nm.Text=getLabel(p,isFav)
		nm.TextColor3=isFav and Color3.fromRGB(255,220,80) or Color3.new(1,1,1)
		nm.Font=Enum.Font.SourceSansBold; nm.TextSize=10
		nm.TextXAlignment=Enum.TextXAlignment.Left; nm.TextTruncate=Enum.TextTruncate.AtEnd
		local fav=Instance.new("TextButton",row)
		fav.Size=UDim2.new(0,26,1,-4); fav.Position=UDim2.new(1,-135,0,2)
		fav.BackgroundColor3=isFav and Color3.fromRGB(150,110,20) or Color3.fromRGB(70,70,70)
		fav.BorderSizePixel=0; fav.Text=isFav and "*" or "o"
		fav.TextColor3=Color3.new(1,1,1); fav.Font=Enum.Font.SourceSansBold; fav.TextSize=14
		Instance.new("UICorner",fav).CornerRadius=UDim.new(0,3)
		local tp=Instance.new("TextButton",row)
		tp.Size=UDim2.new(0,38,1,-4); tp.Position=UDim2.new(1,-105,0,2)
		tp.BackgroundColor3=Color3.fromRGB(70,70,70); tp.BorderSizePixel=0
		tp.Text="TP"; tp.TextColor3=Color3.new(1,1,1); tp.Font=Enum.Font.SourceSansBold; tp.TextSize=10
		Instance.new("UICorner",tp).CornerRadius=UDim.new(0,3)
		local sp=Instance.new("TextButton",row)
		sp.Size=UDim2.new(0,40,1,-4); sp.Position=UDim2.new(1,-63,0,2)
		sp.BackgroundColor3=Color3.fromRGB(70,70,70); sp.BorderSizePixel=0
		sp.Text=t("spectate"); sp.TextColor3=Color3.new(1,1,1); sp.Font=Enum.Font.SourceSansBold; sp.TextSize=8
		Instance.new("UICorner",sp).CornerRadius=UDim.new(0,3)
		local hd=Instance.new("TextButton",row)
		hd.Size=UDim2.new(0,56,1,-4); hd.Position=UDim2.new(1,-19,0,2)
		hd.BackgroundColor3=Color3.fromRGB(70,70,70); hd.BorderSizePixel=0
		hd.Text=hidden[p] and t("show") or t("hide"); hd.TextColor3=Color3.new(1,1,1)
		hd.Font=Enum.Font.SourceSansBold; hd.TextSize=8
		Instance.new("UICorner",hd).CornerRadius=UDim.new(0,3)
		tp.MouseButton1Click:Connect(function()
			local mr=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			local tr=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if mr and tr then S.skipTPNow(0.5); mr.CFrame=CFrame.new(tr.Position+Vector3.new(0,3,0)) end
		end)
		local watching=false
		sp.MouseButton1Click:Connect(function()
			if watching then watching=false; sp.Text=t("spectate"); sp.BackgroundColor3=Color3.fromRGB(70,70,70)
				local mh=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
				if mh then Cam.CameraSubject=mh; Cam.CameraType=Enum.CameraType.Custom end
			else watching=true; sp.Text=t("stop"); sp.BackgroundColor3=Color3.fromRGB(0,120,0)
				local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
				if h then Cam.CameraSubject=h; Cam.CameraType=Enum.CameraType.Custom end end
		end)
		hd.MouseButton1Click:Connect(function()
			if hidden[p] then showP(p); hd.Text=t("hide"); hd.BackgroundColor3=Color3.fromRGB(70,70,70)
			else hideP(p); hd.Text=t("show"); hd.BackgroundColor3=Color3.fromRGB(0,120,0) end
		end)
		fav.MouseButton1Click:Connect(function()
			if favorites[p.UserId] then favorites[p.UserId]=nil else favorites[p.UserId]=p.Name end
			saveFav(); refreshP()
		end)
	end
end
S.refreshPlayers = refreshP
searchBox:GetPropertyChangedSignal("Text"):Connect(function() refreshP() end)
refreshP()
Players.PlayerAdded:Connect(function() task.wait(0.5); refreshP() end)
Players.PlayerRemoving:Connect(function(p) task.wait(0.1); hidden[p]=nil; if hideC[p] then hideC[p]:Disconnect(); hideC[p]=nil end; refreshP() end)
print("[UCS] Players ok")

-- ============================================================
-- ADDONS v3
-- ============================================================
local ADDON_FILE="UCS_Addons.json"
local addonStore = {remote={version="0", addons={}}, localVersion={}, hidden={}, custom={}, autoLoad={}}
local runningAddons = {}

local function saveAddonStore()
	pcall(function() writefile(ADDON_FILE, Http:JSONEncode(addonStore)) end)
end
local function loadAddonStore()
	pcall(function()
		if isfile and isfile(ADDON_FILE) then
			local raw = readfile(ADDON_FILE)
			local d = Http:JSONDecode(raw)
			if type(d) == "table" then
				if d[1] and d[1].url then
					addonStore.custom = d
				else
					if type(d.remote)=="table" then addonStore.remote=d.remote end
					if type(d.localVersion)=="table" then addonStore.localVersion=d.localVersion end
					if type(d.hidden)=="table" then addonStore.hidden=d.hidden end
					if type(d.custom)=="table" then addonStore.custom=d.custom end
					if type(d.autoLoad)=="table" then addonStore.autoLoad=d.autoLoad end
				end
			end
		end
	end)
end
loadAddonStore()

local function fetchRemoteAddons()
	local ok, src = pcall(function() return game:HttpGet(S.ADDONS_URL.."?t="..tostring(tick()), true) end)
	if not ok or not src or #src < 20 then return false end
	local ok2, data = pcall(function() return Http:JSONDecode(src) end)
	if not ok2 or type(data) ~= "table" or type(data.addons) ~= "table" then return false end
	addonStore.remote = data
	saveAddonStore()
	return true
end

local function getMergedAddons()
	local list = {}
	for _,a in ipairs(addonStore.remote.addons or {}) do
		if type(a)=="table" and a.url and not addonStore.hidden[a.url] then
			table.insert(list, {name=a.name or "Addon", url=a.url, desc=a.desc or "",
				version=tostring(a.version or "1.0.0"), author=a.author or "", source="remote"})
		end
	end
	for _,a in ipairs(addonStore.custom or {}) do
		if type(a)=="table" and a.url and not addonStore.hidden[a.url] then
			table.insert(list, {name=a.name or "Addon", url=a.url, desc=a.desc or "",
				version=tostring(a.version or "1.0.0"), author=a.author or "", source="custom"})
		end
	end
	return list
end

local function hasUpdate(url, remoteVersion)
	local localV = addonStore.localVersion[url]
	if not localV then return false end
	return tostring(localV) ~= tostring(remoteVersion)
end

local function snapshotUnloadFns()
	local set = {}
	for k,v in pairs(_G) do
		if type(k)=="string" and k:match("^UCS_.+_Unload$") and type(v)=="function" then set[k]=true end
	end
	return set
end
local function detectNewUnload(before)
	for k,v in pairs(_G) do
		if type(k)=="string" and k:match("^UCS_.+_Unload$") and type(v)=="function" and not before[k] then
			return v
		end
	end
	return nil
end
local function runAddon(url, name, version, source)
	if runningAddons[url] then return false, "already running" end
	local before = snapshotUnloadFns()
	local ok, err = pcall(function()
		local src = game:HttpGet(url)
		if not src or #src < 100 then error("empty response") end
		local fn, perr = loadstring(src)
		if not fn then error(perr or "loadstring nil") end
		fn()
	end)
	if not ok then return false, tostring(err) end
	local unloadFn = detectNewUnload(before)
	runningAddons[url] = {name=name, unload=unloadFn or function() end}
	if source=="remote" and version then
		addonStore.localVersion[url] = version
	end
	return true
end

local ALf=Instance.new("Frame",S.Tabs.Addons)
ALf.Size=UDim2.new(1,-5,0,0); ALf.AutomaticSize=Enum.AutomaticSize.Y
ALf.BackgroundTransparency=1
Instance.new("UIListLayout",ALf).Padding=UDim.new(0,4)

local refreshBtn=Instance.new("TextButton",S.Tabs.Addons)
refreshBtn.Size=UDim2.new(1,-5,0,28); refreshBtn.LayoutOrder=0
refreshBtn.BackgroundColor3=Color3.fromRGB(60,60,110); refreshBtn.BorderSizePixel=0
refreshBtn.Text=t("addon_refresh"); refreshBtn.TextColor3=Color3.new(1,1,1)
refreshBtn.Font=Enum.Font.SourceSansBold; refreshBtn.TextSize=11
Instance.new("UICorner",refreshBtn).CornerRadius=UDim.new(0,4)

local addBox=Instance.new("TextBox",S.Tabs.Addons)
addBox.Size=UDim2.new(1,-5,0,30); addBox.LayoutOrder=1
addBox.BackgroundColor3=Color3.fromRGB(45,45,45); addBox.BorderSizePixel=0
addBox.Text=""; addBox.PlaceholderText=t("addon_url_ph")
addBox.TextColor3=Color3.new(1,1,1); addBox.PlaceholderColor3=Color3.fromRGB(140,140,140)
addBox.Font=Enum.Font.SourceSansBold; addBox.TextSize=11; addBox.ClearTextOnFocus=false
Instance.new("UICorner",addBox).CornerRadius=UDim.new(0,4)
local nameBox=Instance.new("TextBox",S.Tabs.Addons)
nameBox.Size=UDim2.new(1,-5,0,30); nameBox.LayoutOrder=2
nameBox.BackgroundColor3=Color3.fromRGB(45,45,45); nameBox.BorderSizePixel=0
nameBox.Text=""; nameBox.PlaceholderText=t("addon_name_ph")
nameBox.TextColor3=Color3.new(1,1,1); nameBox.PlaceholderColor3=Color3.fromRGB(140,140,140)
nameBox.Font=Enum.Font.SourceSansBold; nameBox.TextSize=11; nameBox.ClearTextOnFocus=false
Instance.new("UICorner",nameBox).CornerRadius=UDim.new(0,4)
local addBtn=Instance.new("TextButton",S.Tabs.Addons)
addBtn.Size=UDim2.new(1,-5,0,30); addBtn.LayoutOrder=3
addBtn.BackgroundColor3=Color3.fromRGB(0,120,180); addBtn.BorderSizePixel=0
addBtn.Text=t("addon_add"); addBtn.TextColor3=Color3.new(1,1,1)
addBtn.Font=Enum.Font.SourceSansBold; addBtn.TextSize=12
Instance.new("UICorner",addBtn).CornerRadius=UDim.new(0,4)
local clearBtn=Instance.new("TextButton",S.Tabs.Addons)
clearBtn.Size=UDim2.new(1,-5,0,28); clearBtn.LayoutOrder=4
clearBtn.BackgroundColor3=Color3.fromRGB(120,40,40); clearBtn.BorderSizePixel=0
clearBtn.Text=t("addon_clear"); clearBtn.TextColor3=Color3.new(1,1,1)
clearBtn.Font=Enum.Font.SourceSansBold; clearBtn.TextSize=11
Instance.new("UICorner",clearBtn).CornerRadius=UDim.new(0,4)

local function refreshAddons()
	for _,c in ipairs(ALf:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	local list = getMergedAddons()
	if #list == 0 then
		local empty=Instance.new("Frame",ALf); empty.Size=UDim2.new(1,0,0,40); empty.BackgroundTransparency=1
		local lbl=Instance.new("TextLabel",empty); lbl.Size=UDim2.new(1,0,1,0); lbl.BackgroundTransparency=1
		lbl.Text=t("addon_empty"); lbl.TextColor3=Color3.fromRGB(140,140,140)
		lbl.Font=Enum.Font.SourceSansBold; lbl.TextSize=11
		return
	end
	for i,a in ipairs(list) do
		local isRunning = runningAddons[a.url] ~= nil
		local upd = (not isRunning) and (a.source=="remote") and hasUpdate(a.url, a.version)
		local row=Instance.new("Frame",ALf); row.Size=UDim2.new(1,0,0,52)
		row.BackgroundColor3=Color3.fromRGB(45,45,45); row.BorderSizePixel=0
		Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
		if upd then
			local bar=Instance.new("Frame",row)
			bar.Size=UDim2.new(0,3,1,-8); bar.Position=UDim2.new(0,4,0,4)
			bar.BackgroundColor3=Color3.fromRGB(255,200,60); bar.BorderSizePixel=0
			Instance.new("UICorner",bar).CornerRadius=UDim.new(0,2)
		elseif isRunning then
			local bar=Instance.new("Frame",row)
			bar.Size=UDim2.new(0,3,1,-8); bar.Position=UDim2.new(0,4,0,4)
			bar.BackgroundColor3=Color3.fromRGB(80,200,80); bar.BorderSizePixel=0
			Instance.new("UICorner",bar).CornerRadius=UDim.new(0,2)
		end
		local leftOffset = (upd or isRunning) and 12 or 6
		local name=Instance.new("TextLabel",row)
		name.Size=UDim2.new(1,-92,0,18); name.Position=UDim2.new(0,leftOffset,0,2)
		name.BackgroundTransparency=1; name.Text=a.name; name.TextColor3=Color3.new(1,1,1)
		name.Font=Enum.Font.SourceSansBold; name.TextSize=12
		name.TextXAlignment=Enum.TextXAlignment.Left; name.TextTruncate=Enum.TextTruncate.AtEnd
		local versionLine = t("addon_version")..a.version
		if upd then
			local localV = addonStore.localVersion[a.url]
			versionLine = t("addon_version")..tostring(localV).."  →  "..t("addon_version")..a.version
		end
		if a.author ~= "" then versionLine = versionLine .. "  ·  "..t("addon_author").." "..a.author end
		local desc=Instance.new("TextLabel",row)
		desc.Size=UDim2.new(1,-92,0,14); desc.Position=UDim2.new(0,leftOffset,0,20)
		desc.BackgroundTransparency=1
		desc.Text = versionLine.."   "..(a.desc~="" and ("— "..a.desc) or "")
		desc.TextColor3 = upd and Color3.fromRGB(255,210,80) or (isRunning and Color3.fromRGB(120,220,120) or Color3.fromRGB(150,150,150))
		desc.Font=Enum.Font.SourceSans; desc.TextSize=9
		desc.TextXAlignment=Enum.TextXAlignment.Left; desc.TextTruncate=Enum.TextTruncate.AtEnd
		local status=Instance.new("TextLabel",row)
		status.Size=UDim2.new(0,90,0,12); status.Position=UDim2.new(0,leftOffset,0,36)
		status.BackgroundTransparency=1
		status.Text = isRunning and t("addon_status_running") or ""
		status.TextColor3 = isRunning and Color3.fromRGB(80,200,80) or Color3.fromRGB(180,180,180)
		status.Font=Enum.Font.SourceSansBold; status.TextSize=8
		status.TextXAlignment=Enum.TextXAlignment.Left
		local runBtn=Instance.new("TextButton",row)
		runBtn.Size=UDim2.new(0,50,1,-8); runBtn.Position=UDim2.new(1,-84,0,4)
		if isRunning then
			runBtn.BackgroundColor3=Color3.fromRGB(180,60,60); runBtn.Text="STOP"; runBtn.TextSize=11
		elseif upd then
			runBtn.BackgroundColor3=Color3.fromRGB(200,150,0); runBtn.Text=t("addon_update_badge"); runBtn.TextSize=8
		else
			runBtn.BackgroundColor3=Color3.fromRGB(0,140,60); runBtn.Text="RUN"; runBtn.TextSize=11
		end
		runBtn.BorderSizePixel=0
		runBtn.TextColor3=Color3.new(1,1,1); runBtn.Font=Enum.Font.SourceSansBold
		Instance.new("UICorner",runBtn).CornerRadius=UDim.new(0,3)
		local delBtn=Instance.new("TextButton",row)
		delBtn.Size=UDim2.new(0,28,1,-8); delBtn.Position=UDim2.new(1,-32,0,4)
		delBtn.BackgroundColor3=Color3.fromRGB(140,40,40); delBtn.BorderSizePixel=0
		delBtn.Text="X"; delBtn.TextColor3=Color3.new(1,1,1); delBtn.Font=Enum.Font.SourceSansBold; delBtn.TextSize=12
		Instance.new("UICorner",delBtn).CornerRadius=UDim.new(0,3)
		runBtn.MouseButton1Click:Connect(function()
			if runningAddons[a.url] then
				local info = runningAddons[a.url]
				if info and info.unload then pcall(info.unload) end
				runningAddons[a.url] = nil
				addonStore.autoLoad[a.url] = nil
				saveAddonStore()
				S.notify(a.name.." — "..t("addon_stopped"), Color3.fromRGB(200,100,80))
				refreshAddons()
				return
			end
			S.notify(t("n_loading").." "..a.name, Color3.fromRGB(180,180,80))
			status.Text=""
			task.spawn(function()
				local ok, err = runAddon(a.url, a.name, a.version, a.source)
				if not ok then
					S.notify(t("n_error")..": "..tostring(err):sub(1,60),Color3.fromRGB(255,80,80))
					status.Text=t("addon_status_err")
					status.TextColor3=Color3.fromRGB(255,80,80)
					row.BackgroundColor3=Color3.fromRGB(60,30,30)
				else
					addonStore.autoLoad[a.url] = true
					saveAddonStore()
					S.notify(a.name.." "..t("n_started"),Color3.fromRGB(0,180,0))
					refreshAddons()
				end
			end)
		end)
		delBtn.MouseButton1Click:Connect(function()
			local info = runningAddons[a.url]
			if info and info.unload then pcall(info.unload) end
			runningAddons[a.url] = nil
			addonStore.autoLoad[a.url] = nil
			if a.source == "remote" then
				addonStore.hidden[a.url] = true
			else
				for j,c in ipairs(addonStore.custom) do
					if c.url == a.url then table.remove(addonStore.custom, j); break end
				end
			end
			saveAddonStore(); refreshAddons()
		end)
	end
end

refreshBtn.MouseButton1Click:Connect(function()
	refreshBtn.Text = t("addon_refreshing")
	local ok = fetchRemoteAddons()
	refreshAddons()
	refreshBtn.Text = t("addon_refresh")
	if ok then
		S.notify(t("n_addons_updated"), Color3.fromRGB(0,180,0))
	else
		S.notify(t("n_addon_fetch_fail"), Color3.fromRGB(255,80,80))
	end
end)

addBtn.MouseButton1Click:Connect(function()
	local url=(addBox.Text or ""):gsub("^%s+",""):gsub("%s+$","")
	if url=="" then S.notify(t("n_url_empty"),Color3.fromRGB(255,180,100)); return end
	local nm=(nameBox.Text or ""):gsub("^%s+",""):gsub("%s+$","")
	if nm=="" then nm="Addon "..(#addonStore.custom+1) end
	table.insert(addonStore.custom,{name=nm,url=url,desc="Saved URL",version="1.0.0",author=""})
	addBox.Text=""; nameBox.Text=""
	saveAddonStore(); refreshAddons()
	S.notify(t("n_addon_added"),Color3.fromRGB(0,180,0))
end)
clearBtn.MouseButton1Click:Connect(function()
	for url, info in pairs(runningAddons) do
		if info and info.unload then pcall(info.unload) end
	end
	runningAddons = {}
	addonStore.custom={}
	saveAddonStore(); refreshAddons()
	S.notify(t("n_cleared"),Color3.fromRGB(200,80,80))
end)

local restoreBtn=Instance.new("TextButton",S.Tabs.Addons)
restoreBtn.Size=UDim2.new(1,-5,0,26); restoreBtn.LayoutOrder=5
restoreBtn.BackgroundColor3=Color3.fromRGB(60,80,120); restoreBtn.BorderSizePixel=0
restoreBtn.Text = (S.lang=="ru") and "♻ Восстановить скрытые аддоны" or "♻ Restore hidden addons"
restoreBtn.TextColor3=Color3.new(1,1,1)
restoreBtn.Font=Enum.Font.SourceSansBold; restoreBtn.TextSize=10
Instance.new("UICorner",restoreBtn).CornerRadius=UDim.new(0,4)
restoreBtn.MouseButton1Click:Connect(function()
	local count = 0
	for url, _ in pairs(addonStore.hidden) do count = count + 1 end
	addonStore.hidden = {}
	saveAddonStore()
	refreshAddons()
	S.notify((S.lang=="ru") and ("Восстановлено: "..count) or ("Restored: "..count), Color3.fromRGB(0,180,0))
end)

S.refreshAddons=refreshAddons
refreshAddons()

task.spawn(function()
	task.wait(1)
	local ok = fetchRemoteAddons()
	if ok then refreshAddons() end
end)

task.spawn(function()
	task.wait(2.5)
	local started = {}
	for url, _ in pairs(addonStore.autoLoad or {}) do
		local found = nil
		for _, a in ipairs(getMergedAddons()) do
			if a.url == url then found = a; break end
		end
		if found then
			local ok = runAddon(found.url, found.name, found.version, found.source)
			if ok then table.insert(started, found.name) end
		end
	end
	if #started > 0 then
		refreshAddons()
		S.notify((S.lang=="ru" and "Автозапуск: " or "Auto-loaded: ")..table.concat(started, ", "), Color3.fromRGB(0,200,0))
	end
end)
print("[UCS] Addons v3 ok")

