-- NUM INPUT POPUP
-- ============================================================
function S._openNumInput(setKey, toggleKey)
	local cur = S.C[setKey]
	if type(cur) ~= "number" then cur = 0 end

	local popup = Instance.new("Frame", S.SG)
	popup.Size = UDim2.new(0, 230, 0, 100)
	popup.Position = UDim2.new(0.5, -115, 0.5, -50)
	popup.BackgroundColor3 = Color3.fromRGB(35,35,42)
	popup.BorderSizePixel = 0
	popup.ZIndex = 500
	Instance.new("UICorner", popup).CornerRadius = UDim.new(0,8)
	local ps = Instance.new("UIStroke", popup); ps.Color=Color3.fromRGB(255,140,0); ps.Thickness=1.5

	local title = Instance.new("TextLabel", popup)
	title.Size = UDim2.new(1, -20, 0, 18)
	title.Position = UDim2.new(0, 10, 0, 6)
	title.BackgroundTransparency = 1
	title.Text = setKey.."  ("..t("num_input_now")..": "..tostring(cur)..")"
	title.TextColor3 = Color3.fromRGB(255,180,80)
	title.Font = Enum.Font.SourceSansBold
	title.TextSize = 11
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 501

	local box = Instance.new("TextBox", popup)
	box.Size = UDim2.new(1, -20, 0, 30)
	box.Position = UDim2.new(0, 10, 0, 28)
	box.BackgroundColor3 = Color3.fromRGB(50,50,55)
	box.BorderSizePixel = 0
	box.Text = tostring(cur)
	box.TextColor3 = Color3.new(1,1,1)
	box.PlaceholderText = "number"
	box.PlaceholderColor3 = Color3.fromRGB(140,140,140)
	box.Font = Enum.Font.SourceSansBold
	box.TextSize = 14
	box.ClearTextOnFocus = false
	box.ZIndex = 501
	Instance.new("UICorner", box).CornerRadius = UDim.new(0,4)

	local save = Instance.new("TextButton", popup)
	save.Size = UDim2.new(0.45, -5, 0, 24)
	save.Position = UDim2.new(0.05, 0, 1, -30)
	save.BackgroundColor3 = Color3.fromRGB(0,140,60)
	save.BorderSizePixel = 0
	save.Text = t("num_input_ok")
	save.TextColor3 = Color3.new(1,1,1)
	save.Font = Enum.Font.SourceSansBold
	save.TextSize = 11
	save.ZIndex = 501
	Instance.new("UICorner", save).CornerRadius = UDim.new(0,4)

	local cancel = Instance.new("TextButton", popup)
	cancel.Size = UDim2.new(0.45, -5, 0, 24)
	cancel.Position = UDim2.new(0.5, 0, 1, -30)
	cancel.BackgroundColor3 = Color3.fromRGB(140,40,40)
	cancel.BorderSizePixel = 0
	cancel.Text = "✕"
	cancel.TextColor3 = Color3.new(1,1,1)
	cancel.Font = Enum.Font.SourceSansBold
	cancel.TextSize = 11
	cancel.ZIndex = 501
	Instance.new("UICorner", cancel).CornerRadius = UDim.new(0,4)

	local function apply()
		local val = tonumber(box.Text)
		if val then
			S.C[setKey] = val
			local owners = (S._setKeyOwners or {})[setKey]
			if owners then
				for _, o in ipairs(owners) do
					if o.cb and o.btn and o.btn.Parent then pcall(o.cb, o.btn, "refresh") end
				end
			end
		end
		popup:Destroy()
	end
	save.MouseButton1Click:Connect(apply)
	cancel.MouseButton1Click:Connect(function() popup:Destroy() end)
	box.FocusLost:Connect(function(enter) if enter then apply() end end)
	box:CaptureFocus()
end

-- ============================================================
-- addR (with long-press number input + hold-acceleration)
-- ============================================================
function S.addR(tab,txt,cb,hasS,key,setKey)
	local R=Instance.new("Frame",S.Tabs[tab])
	R.Size=UDim2.new(1,-5,0,32); R.BackgroundTransparency=1
	local MB=Instance.new("TextButton",R)
	MB.Size=hasS and UDim2.new(0.60,-5,1,0) or UDim2.new(1,0,1,0)
	MB.BackgroundColor3=Color3.fromRGB(50,50,50); MB.BorderSizePixel=0
	MB.Text=txt; MB.TextColor3=Color3.new(1,1,1)
	MB.Font=Enum.Font.SourceSansBold; MB.TextSize=12
	Instance.new("UICorner",MB).CornerRadius=UDim.new(0,4)

	local function wrapped(b,a,val)
		if key and type(S.C[key])=="boolean" then
			if a=="on" then if not S.C[key] then cb(b,"toggle") end return
			elseif a=="off" then if S.C[key] then cb(b,"toggle") end return end
		end
		cb(b,a,val)
	end

	local pressStart=0
	local longFired=false
	local longTask=0
	MB.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
			pressStart=tick()
			longFired=false
			if hasS and setKey then
				longTask=longTask+1
				local myId=longTask
				task.spawn(function()
					task.wait(0.7)
					if longTask==myId and pressStart>0 and not longFired and (tick()-pressStart)>=0.7 then
						longFired=true
						if S._openNumInput then S._openNumInput(setKey,key) end
					end
				end)
			end
		end
	end)
	MB.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
			local held=tick()-pressStart
			local wasLong=longFired
			pressStart=0
			longTask=longTask+1
			if not wasLong and held<0.7 then
				wrapped(MB,"toggle")
			end
		end
	end)

	if hasS then
		local function sld(lbl,pos,a)
			local btn=Instance.new("TextButton",R)
			btn.Size=UDim2.new(0,25,1,0); btn.Position=UDim2.new(0.60,pos,0,0)
			btn.BackgroundColor3=Color3.fromRGB(45,45,45); btn.BorderSizePixel=0
			btn.Text=lbl; btn.TextColor3=Color3.new(1,1,1)
			btn.Font=Enum.Font.SourceSansBold
			btn.TextSize=14
			Instance.new("UICorner",btn).CornerRadius=UDim.new(0,4)

			local active=false
			local taskId=0

			btn.MouseButton1Down:Connect(function()
				active=true
				taskId=taskId+1
				local myId=taskId
				local startT=tick()
				wrapped(MB,a)
				task.spawn(function()
					while active and taskId==myId do
						local elapsed=tick()-startT
						local interval
						if elapsed<3 then interval=0.15
						elseif elapsed<5 then interval=0.07
						else interval=0.03 end
						task.wait(interval)
						if not active or taskId~=myId then break end
						wrapped(MB,a)
					end
				end)
			end)
			btn.InputEnded:Connect(function(i)
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					active=false
				end
			end)
		end
		sld("-",0,"minus"); sld("+",27,"plus")
	end

	if key then S.toggles[key]={btn=MB,cb=wrapped} end
	if setKey then
		S._setKeyOwners[setKey] = S._setKeyOwners[setKey] or {}
		table.insert(S._setKeyOwners[setKey], {btn=MB, cb=wrapped, key=key})
	end
	return MB
end
local C=S.C
local addR=S.addR

function S.applyPanelTransparency(v)
	local tt=math.clamp(v/100,0,0.9)
	pcall(function() MF.BackgroundTransparency=tt end)
	pcall(function() Tl.BackgroundTransparency=math.clamp(tt+0.05,0,1) end)
	pcall(function() TB.BackgroundTransparency=math.clamp(tt+0.05,0,1) end)
end

-- STEALTH
local stealthTrigger=nil
local function ensureStealth()
	if stealthTrigger and stealthTrigger.Parent then return end
	stealthTrigger=Instance.new("TextButton",SG)
	stealthTrigger.Size=UDim2.new(0,40,0,40)
	stealthTrigger.BackgroundTransparency=1; stealthTrigger.Text=""
	stealthTrigger.AutoButtonColor=false; stealthTrigger.ZIndex=9999
	if C.stealthCorner=="TL" then stealthTrigger.Position=UDim2.new(0,0,0,0)
	elseif C.stealthCorner=="TR" then stealthTrigger.Position=UDim2.new(1,-40,0,0)
	elseif C.stealthCorner=="BL" then stealthTrigger.Position=UDim2.new(0,0,1,-40)
	else stealthTrigger.Position=UDim2.new(1,-40,1,-40) end
	local lastTap=0
	stealthTrigger.MouseButton1Click:Connect(function()
		local now=tick()
		if now-lastTap<0.6 then S.exitStealth() end
		lastTap=now
	end)
end
function S.enterStealth()
	C.stealthHidden=true
	pcall(function() MF.Visible=false end)
	pcall(function() Op.Visible=false end)
	ensureStealth()
	S.notify(t("n_stealth_on"),Color3.fromRGB(120,200,255))
end
function S.exitStealth()
	C.stealthHidden=false
	if MF.Position.X.Offset<=-9000 then MF.Position=UDim2.new(0.5,-145,0.5,-188) end
	MF.Visible=true; Op.Visible=false
	if stealthTrigger then pcall(function() stealthTrigger:Destroy() end); stealthTrigger=nil end
	S.notify(t("n_stealth_off"),Color3.fromRGB(120,200,255))
end
StealthBtn.MouseButton1Click:Connect(function() S.enterStealth() end)

-- ============================================================
-- MAIN
-- ============================================================
local function applySpd(_,reset) pcall(function() local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed=reset and 16 or C.tSp end end) end
addR("Main",t("run").." ("..C.tSp..")",function(b,a)
	if a=="toggle" then C.sEn=not C.sEn
		if C.sEn then b.BackgroundColor3=Color3.fromRGB(0,120,0); S.addT("Speed",applySpd,0.1); applySpd()
		else b.BackgroundColor3=Color3.fromRGB(50,50,50); S.delT("Speed"); applySpd(nil,true) end
	elseif a=="minus" then C.tSp=C.tSp-10; if C.sEn then applySpd() end
	elseif a=="plus" then C.tSp=C.tSp+10; if C.sEn then applySpd() end end
	b.Text=t("run")..": "..(C.sEn and t("on") or t("off")).." ("..C.tSp..")"
end,true,"sEn","tSp")

local flyBV
local function startFly()
	local char=LP.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	local hum=char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then C.fEn=false; return end
	hum.PlatformStand=true
	if flyBV and flyBV.Parent then flyBV:Destroy() end
	flyBV=Instance.new("BodyPosition",root); flyBV.Name="UcsFlyPos"
	flyBV.MaxForce=Vector3.new(9e9,9e9,9e9); flyBV.Position=root.Position
	S.dis("Fly")
	S.conns.Fly=RS.RenderStepped:Connect(function()
		if not root.Parent or not flyBV or not flyBV.Parent then return end
		root.Velocity=Vector3.zero; root.RotVelocity=Vector3.zero
		local md=hum.MoveDirection; local np=flyBV.Position
		if md.Magnitude>0 then
			local lv=Cam.CFrame.LookVector
			local dir=md:Dot(lv*Vector3.new(1,0,1))>0 and lv or -lv
			np=np+dir.Unit*C.fSp
		end
		flyBV.Position=np
		root.CFrame=CFrame.new(root.Position,root.Position+Vector3.new(Cam.CFrame.LookVector.X,0,Cam.CFrame.LookVector.Z))
	end)
end
local function stopFly()
	S.dis("Fly")
	pcall(function()
		local char=LP.Character
		local root=char and char:FindFirstChild("HumanoidRootPart")
		local hum=char and char:FindFirstChildOfClass("Humanoid")
		if root and root:FindFirstChild("UcsFlyPos") then root.UcsFlyPos:Destroy() end
		if hum then hum.PlatformStand=false end
	end)
	flyBV=nil
end
S.startFly=startFly; S.stopFly=stopFly
function S.toggleFly()
	C.fEn=not C.fEn
	if C.fEn then startFly() else stopFly() end
	if S.toggles.fEn then
		local tb=S.toggles.fEn.btn
		if C.fEn then tb.Text=t("fly")..": "..t("on").." ("..C.fSp..")"; tb.BackgroundColor3=Color3.fromRGB(0,120,0)
		else tb.Text=t("fly")..": "..t("off").." ("..C.fSp..")"; tb.BackgroundColor3=Color3.fromRGB(50,50,50) end
	end
end
addR("Main",t("fly").." ("..C.fSp..")",function(b,a)
	if a=="toggle" then C.fEn=not C.fEn
		if C.fEn then b.BackgroundColor3=Color3.fromRGB(0,120,0); startFly()
		else b.BackgroundColor3=Color3.fromRGB(50,50,50); stopFly() end
	elseif a=="minus" then C.fSp=math.max(1,C.fSp-1)
	elseif a=="plus" then C.fSp=C.fSp+1 end
	b.Text=t("fly")..": "..(C.fEn and t("on") or t("off")).." ("..C.fSp..")"
end,true,"fEn","fSp")

addR("Main",t("jump").." ("..C.jPw..")",function(b,a)
	if a=="toggle" then C.jpEn=not C.jpEn
		if C.jpEn then b.BackgroundColor3=Color3.fromRGB(0,120,0)
			S.addT("Jump",function() pcall(function() local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if h then h.UseJumpPower=true; h.JumpPower=C.jPw end end) end,0.2)
		else b.BackgroundColor3=Color3.fromRGB(50,50,50); S.delT("Jump")
			pcall(function() local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if h then h.JumpPower=50 end end) end
	elseif a=="minus" then C.jPw=math.max(1,C.jPw-10)
	elseif a=="plus" then C.jPw=C.jPw+10 end
	b.Text=t("jump")..": "..(C.jpEn and t("on") or t("off")).." ("..C.jPw..")"
end,true,"jpEn","jPw")

addR("Main",t("infjump"),function(b,a)
	if a=="toggle" then
		C.jEn=not C.jEn
		if C.jEn then
			S.conns.InfJump=UIS.JumpRequest:Connect(function() pcall(function() local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end) end)
		else S.dis("InfJump") end
	end
	if C.jEn then b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("infjump")..": "..t("on")
	else b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("infjump")..": "..t("off") end
end,false,"jEn")

addR("Main",t("autojump"),function(b,a)
	if a=="toggle" then
		C.autojumpEn=not C.autojumpEn
		if C.autojumpEn then
			S.conns.AutoJump=RS.Heartbeat:Connect(function()
				local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
				if not hum then return end
				if hum.MoveDirection.Magnitude>0.1 and hum:GetState()==Enum.HumanoidStateType.Running then
					pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
				end
			end)
		else S.dis("AutoJump") end
	end
	if C.autojumpEn then b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("autojump")..": "..t("on")
	else b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("autojump")..": "..t("off") end
end,false,"autojumpEn")

addR("Main",t("noclip"),function(b,a)
	if a=="toggle" then
		C.nEn=not C.nEn
		if C.nEn then
			S.conns.Noclip=RS.PreSimulation:Connect(function() S.col(LP.Character,false) end)
		else
			S.dis("Noclip"); S.col(LP.Character,true)
		end
	end
	if C.nEn then
		b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("noclip")..": "..t("on")
	else
		b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("noclip")..": "..t("off")
	end
end,false,"nEn")

-- Click TP (PC only)
local function doClickTP(pos)
	local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local ray=Cam:ViewportPointToRay(pos.X, pos.Y)
	local params=RaycastParams.new()
	params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={LP.Character}
	local res=workspace:Raycast(ray.Origin, ray.Direction*1000, params)
	if res then
		S.skipTPNow(0.3)
		root.Velocity=Vector3.zero
		root.CFrame=CFrame.new(res.Position + Vector3.new(0,3,0))
	else
		S.skipTPNow(0.3)
		root.Velocity=Vector3.zero
		root.CFrame=CFrame.new(ray.Origin + ray.Direction*50)
	end
end
S.conns.ClickTP=UIS.InputBegan:Connect(function(i,gp)
	if gp then return end
	if not C.clicktpEn then return end
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		if MF.Visible then return end
		doClickTP(i.Position)
	end
end)
addR("Main",t("clicktp"),function(b,a)
	if a=="toggle" then C.clicktpEn=not C.clicktpEn end
	if C.clicktpEn then b.BackgroundColor3=Color3.fromRGB(120,60,180); b.Text=t("clicktp_on")
	else b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("clicktp")..": "..t("off") end
end,false,"clicktpEn")

-- ============================================================
-- FREEZECAM (PC only)
-- ============================================================
local freezePlayerActive=false
local freezePlayerSavedWS, freezePlayerSavedJP, freezePlayerSavedAR
local freezePlayerPos

local function startFreezePlayer()
	local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	freezePlayerSavedWS=hum.WalkSpeed
	freezePlayerSavedJP=hum.JumpPower
	freezePlayerSavedAR=hum.AutoRotate
	freezePlayerPos=Cam.CFrame.Position
	S.dis("FreezePlayer")
	S.conns.FreezePlayer=RS.RenderStepped:Connect(function()
		if not freezePlayerActive then return end
		local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if h then
			h.WalkSpeed=0
			h.JumpPower=0
			h.AutoRotate=false
		end
		local look=Cam.CFrame.LookVector
		Cam.CFrame=CFrame.new(freezePlayerPos, freezePlayerPos+look)
	end)
end
local function stopFreezePlayer()
	S.dis("FreezePlayer")
	local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		if freezePlayerSavedWS then hum.WalkSpeed=freezePlayerSavedWS end
		if freezePlayerSavedJP then hum.JumpPower=freezePlayerSavedJP end
		if freezePlayerSavedAR~=nil then hum.AutoRotate=freezePlayerSavedAR end
	end
end
S.toggleFreezePlayer=function()
	freezePlayerActive=not freezePlayerActive
	if freezePlayerActive then startFreezePlayer() else stopFreezePlayer() end
	if S.toggles.freezePlayerEn then
		local tb=S.toggles.freezePlayerEn.btn
		if freezePlayerActive then tb.Text=t("freeze_player")..": "..t("on"); tb.BackgroundColor3=Color3.fromRGB(0,120,200)
		else tb.Text=t("freeze_player")..": "..t("off"); tb.BackgroundColor3=Color3.fromRGB(50,50,50) end
	end
end
addR("Visual",t("freeze_player"),function(b,a)
	if a~="toggle" then
		if C.freezePlayerEn then b.Text=t("freeze_player")..": "..t("on"); b.BackgroundColor3=Color3.fromRGB(0,120,200)
		else b.Text=t("freeze_player")..": "..t("off"); b.BackgroundColor3=Color3.fromRGB(50,50,50) end
		return
	end
	C.freezePlayerEn=not C.freezePlayerEn
	S.toggleFreezePlayer()
end,false,"freezePlayerEn")

local freezeCamActive=false
local freezeCamCF=nil

local function startFreezeCam()
	freezeCamCF=Cam.CFrame
	Cam.CameraType=Enum.CameraType.Scriptable
	S.dis("FreezeCam")
	S.conns.FreezeCam=RS.RenderStepped:Connect(function()
		if not freezeCamActive then return end
		Cam.CFrame=freezeCamCF
	end)
end
local function stopFreezeCam()
	S.dis("FreezeCam")
	Cam.CameraType=Enum.CameraType.Custom
	local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if hum then Cam.CameraSubject=hum end
end
S.toggleFreezeCam=function()
	freezeCamActive=not freezeCamActive
	if freezeCamActive then startFreezeCam() else stopFreezeCam() end
	if S.toggles.freezeCamEn then
		local tb=S.toggles.freezeCamEn.btn
		if freezeCamActive then tb.Text=t("freeze_cam")..": "..t("on"); tb.BackgroundColor3=Color3.fromRGB(0,120,200)
		else tb.Text=t("freeze_cam")..": "..t("off"); tb.BackgroundColor3=Color3.fromRGB(50,50,50) end
	end
end
addR("Visual",t("freeze_cam"),function(b,a)
	if a~="toggle" then
		if C.freezeCamEn then b.Text=t("freeze_cam")..": "..t("on"); b.BackgroundColor3=Color3.fromRGB(0,120,200)
		else b.Text=t("freeze_cam")..": "..t("off"); b.BackgroundColor3=Color3.fromRGB(50,50,50) end
		return
	end
	C.freezeCamEn=not C.freezeCamEn
	S.toggleFreezeCam()
end,false,"freezeCamEn")

-- PLATFORM
local plat=Instance.new("Part")
plat.Name="UCS_Platform"; plat.Size=Vector3.new(10,1,10); plat.Anchored=true
plat.CanCollide=false; plat.CanQuery=false; plat.CanTouch=false; plat.CastShadow=false
plat.Transparency=0.5; plat.Material=Enum.Material.Neon
plat.Color=Color3.fromRGB(0,200,255); plat.TopSurface=Enum.SurfaceType.Smooth
plat.BottomSurface=Enum.SurfaceType.Smooth; plat.Parent=nil
S.plat=plat
local platBP=nil; local platY=0
local function startPlat()
	local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	platY=root.Position.Y-3.5
	plat.Position=Vector3.new(root.Position.X,platY,root.Position.Z)
	plat.Parent=workspace
	if platBP then platBP:Destroy() end
	platBP=Instance.new("BodyPosition",root); platBP.Name="UCS_PlatBP"
	platBP.MaxForce=Vector3.new(0,1e6,0); platBP.P=1e5; platBP.D=100
	platBP.Position=root.Position
	S.dis("PlatConn")
	S.conns.PlatConn=RS.RenderStepped:Connect(function()
		if not C.platEn then return end
		local r=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if not r then return end
		if not platBP or not platBP.Parent then
			platBP=Instance.new("BodyPosition",r); platBP.Name="UCS_PlatBP"
			platBP.MaxForce=Vector3.new(0,1e6,0); platBP.P=1e5; platBP.D=100
		end
		platBP.Position=Vector3.new(r.Position.X,platY+3.5,r.Position.Z)
		plat.Position=Vector3.new(r.Position.X,platY,r.Position.Z)
	end)
end
local function stopPlat()
	S.dis("PlatConn")
	if platBP then platBP:Destroy(); platBP=nil end
	if plat then plat.Parent=nil end
end
S.startPlat=startPlat; S.stopPlat=stopPlat
addR("Main",t("platform")..": "..t("off"),function(b,a)
	if a=="toggle" then
		C.platEn=not C.platEn
		if C.platEn then startPlat() else stopPlat() end
	end
	if C.platEn then
		b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("platform")..": "..t("on")
	else
		b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("platform")..": "..t("off")
	end
end,false,"platEn")

-- SCREEN BUTTONS disabled on PC
local function doDash()
	local char=LP.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	local hum=char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end
	local dir=hum.MoveDirection
	if dir.Magnitude<0.1 then local lv=Cam.CFrame.LookVector; dir=Vector3.new(lv.X,0,lv.Z) end
	if dir.Magnitude<0.1 then return end
	dir=dir.Unit
	local bv=Instance.new("BodyVelocity",root)
	bv.MaxForce=Vector3.new(1e5,1e5,1e5); bv.P=2000; bv.Velocity=dir*C.dashPower
	task.delay(C.dashDuration,function() if bv and bv.Parent then bv:Destroy() end end)
end
S.doDash=doDash

addR("Main",t("hotkeys_work"),function(b,a)
	if a=="toggle" then C.dashMoveMode=not C.dashMoveMode end
	if C.dashMoveMode then b.Text=t("hotkeys_move"); b.BackgroundColor3=Color3.fromRGB(80,60,180)
	else b.Text=t("hotkeys_work"); b.BackgroundColor3=Color3.fromRGB(0,150,0) end
end,false,"dashMoveMode")

local function doRespawn()
	local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health>0 then pcall(function() hum.Health=0 end) end
	task.wait(0.1)
	pcall(function() LP:LoadCharacter() end)
end
S.doRespawn=doRespawn
print("[UCS] Main ok")

-- ============================================================
-- FUNC
-- ============================================================
local promptCache={}; local clickCache={}; local fiHoldSaved={}; local fiLosSaved={}
local function fiApplyPrompt(o)
	if not o.Parent then return end
	if C.fiSafe then return end
	if fiHoldSaved[o]==nil then fiHoldSaved[o]=o.HoldDuration end
	if fiLosSaved[o]==nil then fiLosSaved[o]=o.RequiresLineOfSight end
	pcall(function() o.HoldDuration=0; o.RequiresLineOfSight=false end)
end
local function fiRestorePrompt(o)
	pcall(function()
		if fiHoldSaved[o]~=nil then o.HoldDuration=fiHoldSaved[o] end
		if fiLosSaved[o]~=nil then o.RequiresLineOfSight=fiLosSaved[o] end
	end)
	fiHoldSaved[o]=nil; fiLosSaved[o]=nil
end
local function fiAdd(o)
	if o:IsA("ProximityPrompt") then promptCache[o]=o; if C.fiEn then fiApplyPrompt(o) end
	elseif o:IsA("ClickDetector") then clickCache[o]=o end
end
local function fiRm(o) promptCache[o]=nil; clickCache[o]=nil; fiHoldSaved[o]=nil; fiLosSaved[o]=nil end
for _,o in ipairs(workspace:GetDescendants()) do fiAdd(o) end
S.conns.FI_Add=workspace.DescendantAdded:Connect(function(o) if o:IsA("ProximityPrompt") or o:IsA("ClickDetector") then task.defer(function() if o.Parent then fiAdd(o) end end) end end)
S.conns.FI_Rem=workspace.DescendantRemoving:Connect(function(o) if o:IsA("ProximityPrompt") or o:IsA("ClickDetector") then fiRm(o) end end)
local FI_P=(typeof(fireproximityprompt)=="function")
local FI_C=(typeof(fireclickdetector)=="function")
local function doFastInteract()
	local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local pos=root.Position; local rad=C.fiRange
	if FI_P then
		for o in pairs(promptCache) do
			if not o.Parent then promptCache[o]=nil; fiHoldSaved[o]=nil; fiLosSaved[o]=nil
			elseif o.Enabled then
				local part=o.Parent
				if part and part:IsA("BasePart") and (part.Position-pos).Magnitude<=rad then
					pcall(fireproximityprompt,o)
				end
			end
		end
	end
	if FI_C then
		for o in pairs(clickCache) do
			if not o.Parent then clickCache[o]=nil
			else
				local part=o.Parent
				if part and part:IsA("BasePart") and (part.Position-pos).Magnitude<=rad then
					pcall(fireclickdetector,o)
				end
			end
		end
	end
end
addR("Func",t("fastint"),function(b,a)
	if a~="toggle" then
		if C.fiEn then b.Text=t("fastint")..": "..t("on"); b.BackgroundColor3=Color3.fromRGB(0,120,0)
		else b.Text=t("fastint")..": "..t("off"); b.BackgroundColor3=Color3.fromRGB(50,50,50) end
		return
	end
	if not FI_P and not FI_C then S.notify(t("n_no_fire"),Color3.fromRGB(255,80,80)); return end
	C.fiEn=not C.fiEn
	if C.fiEn then
		for o in pairs(promptCache) do if o.Parent then fiApplyPrompt(o) end end
		b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("fastint")..": "..t("on")
		S.addT("FastInteract",doFastInteract,0.1)
	else b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("fastint")..": "..t("off"); S.delT("FastInteract")
		for o in pairs(promptCache) do fiRestorePrompt(o) end end
end,false,"fiEn")

addR("Func",t("fi_safe"),function(b,a)
	if a=="toggle" then
		C.fiSafe=not C.fiSafe
		if C.fiSafe then
			for o in pairs(promptCache) do if o.Parent then fiRestorePrompt(o) end end
		elseif C.fiEn then
			for o in pairs(promptCache) do if o.Parent then fiApplyPrompt(o) end end
		end
	end
	if C.fiSafe then b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("fi_safe")..": "..t("on")
	else b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("fi_safe")..": "..t("off") end
end,false,"fiSafe")

local ARc={}
local function applyAR(char)
	local hum=char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false); hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false) end)
	if ARc[char] then ARc[char]:Disconnect() end
	ARc[char]=hum.StateChanged:Connect(function(_,new)
		if C.arEn and (new==Enum.HumanoidStateType.Ragdoll or new==Enum.HumanoidStateType.FallingDown or new==Enum.HumanoidStateType.Physics) then
			pcall(function() hum.PlatformStand=false; hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
	end)
end
S.applyAR=applyAR
addR("Func",t("antiragdoll"),function(b,a)
	if a~="toggle" then
		if C.arEn then b.Text=t("antiragdoll")..": "..t("on"); b.BackgroundColor3=Color3.fromRGB(0,120,0)
		else b.Text=t("antiragdoll")..": "..t("off"); b.BackgroundColor3=Color3.fromRGB(50,50,50) end
		return
	end
	C.arEn=not C.arEn
	if C.arEn then b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("antiragdoll")..": "..t("on"); if LP.Character then applyAR(LP.Character) end
	else b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("antiragdoll")..": "..t("off")
		pcall(function() local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
			if h then h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,true); h:SetStateEnabled(Enum.HumanoidStateType.FallingDown,true) end end) end
end,false,"arEn")

local voidLastSafe=nil
addR("Func",t("antivoid").." ("..C.voidY..")",function(b,a)
	if a=="toggle" then C.avEn=not C.avEn
		if C.avEn then
			b.BackgroundColor3=Color3.fromRGB(0,120,0)
			voidLastSafe=nil
			S.addT("AntiVoid",function()
				local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
				if not root then return end
				local p=root.Position
				if p.Y > C.voidY + 20 then voidLastSafe=p end
				if p.Y < C.voidY and voidLastSafe then
					S.skipTPNow(0.5)
					root.Velocity=Vector3.zero
					root.CFrame=CFrame.new(voidLastSafe + Vector3.new(0,3,0))
					voidLastSafe=nil
				end
			end,0.1)
		else b.BackgroundColor3=Color3.fromRGB(50,50,50); S.delT("AntiVoid"); voidLastSafe=nil end
	elseif a=="minus" then C.voidY=C.voidY-10
	elseif a=="plus" then C.voidY=C.voidY+10 end
	b.Text=t("antivoid")..": "..(C.avEn and t("on") or t("off")).." ("..C.voidY..")"
end,true,"avEn","voidY")
print("[UCS] Func ok")

-- ============================================================
-- NPC
-- ============================================================
local NPCList={}
S.NPCList=NPCList
local NPCCache={}
local function isPlayerChar(m) return m and Players:GetPlayerFromCharacter(m)~=nil end
local function regNPC(h)
	local m=h.Parent
	if not m or NPCCache[m] or isPlayerChar(m) then return end
	NPCCache[m]=h; NPCList[#NPCList+1]=m
end
local function unregNPC(m)
	if not NPCCache[m] then return end
	NPCCache[m]=nil
	for i=#NPCList,1,-1 do if NPCList[i]==m then table.remove(NPCList,i); break end end
end
pcall(function() for _,h in ipairs(workspace:GetDescendants()) do if h:IsA("Humanoid") and h.Health>0 then regNPC(h) end end end)
S.conns.NPCReg=workspace.DescendantAdded:Connect(function(o) if o:IsA("Humanoid") then task.defer(function() if o.Parent and o.Health>0 then regNPC(o) end end) end end)
S.conns.NPCUnreg=workspace.DescendantRemoving:Connect(function(o) if o:IsA("Model") then unregNPC(o) end end)
S.addT("NPCCleanup",function()
	for i=#NPCList,1,-1 do
		local m=NPCList[i]; local h=NPCCache[m]
		if not m.Parent or not h or h.Health<=0 then unregNPC(m) end
	end
end,1.5)
print("[UCS] NPC ok")

-- ============================================================
-- VISUAL
-- ============================================================
local espC={}
local function applyESP(p)
	if p==LP then return end
	local function ap(c)
		if not c or not C.eEn then return end
		local old=c:FindFirstChild("UCS_HL"); if old then old:Destroy() end
		local hl=Instance.new("Highlight",c)
		hl.Name="UCS_HL"; hl.FillColor=Color3.fromRGB(255,30,30)
		hl.FillTransparency=0.4; hl.OutlineColor=Color3.fromRGB(255,255,255)
	end
	if espC[p] then espC[p]:Disconnect() end
	espC[p]=p.CharacterAdded:Connect(function(c) task.wait(0.2); if C.eEn then ap(c) end end)
	if p.Character then ap(p.Character) end
end
local function rmESP(p)
	if espC[p] then espC[p]:Disconnect(); espC[p]=nil end
	pcall(function() local c=p.Character; if c and c:FindFirstChild("UCS_HL") then c.UCS_HL:Destroy() end end)
end
S.rmESP=rmESP
addR("Visual",t("espp"),function(b,a)
	if a~="toggle" then
		if C.eEn then b.Text=t("espp")..": "..t("on"); b.BackgroundColor3=Color3.fromRGB(0,120,0)
		else b.Text=t("espp")..": "..t("off"); b.BackgroundColor3=Color3.fromRGB(50,50,50) end
		return
	end
	C.eEn=not C.eEn
	if C.eEn then b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("espp")..": "..t("on")
		for _,p in ipairs(Players:GetPlayers()) do applyESP(p) end
		S.conns.EspAdd=Players.PlayerAdded:Connect(function(p) task.wait(0.5); if C.eEn then applyESP(p) end end)
		S.conns.EspRem=Players.PlayerRemoving:Connect(function(p) if espC[p] then espC[p]:Disconnect(); espC[p]=nil end end)
	else b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("espp")..": "..t("off"); S.dis("EspAdd"); S.dis("EspRem")
		for _,p in ipairs(Players:GetPlayers()) do rmESP(p) end end
end,false,"eEn")

local npcESP={}
local function addNH(m)
	if npcESP[m] or m:FindFirstChild("UCS_NPC_HL") then return end
	local hl=Instance.new("Highlight",m)
	hl.Name="UCS_NPC_HL"; hl.FillColor=Color3.fromRGB(255,140,0)
	hl.FillTransparency=0.5; hl.OutlineColor=Color3.fromRGB(255,255,0)
	npcESP[m]=hl
end
local function clearNH()
	for _,hl in pairs(npcESP) do pcall(function() hl:Destroy() end) end
	npcESP={}
end
S.clearNH=clearNH
addR("Visual",t("espnpc"),function(b,a)
	if a~="toggle" then return end
	if next(npcESP) then
		clearNH(); S.delT("NPCespSync")
		b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("espnpc")..": "..t("off")
	else
		b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("espnpc")..": "..t("on")
		local list=S.NPCList or {}
		for i=1,#list do addNH(list[i]) end
		S.addT("NPCespSync",function()
			local list2=S.NPCList or {}
			for i=1,#list2 do local m=list2[i]; if not npcESP[m] then addNH(m) end end
			for m,hl in pairs(npcESP) do if not m.Parent then pcall(function() hl:Destroy() end); npcESP[m]=nil end end
		end,1)
	end
end,false)

local function isCharPart(p)
	local parent=p.Parent
	if not parent then return false end
	if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then return true end
	return false
end
local function applyXray(p)
	if p:IsA("BasePart") and not isCharPart(p) then
		pcall(function() p.LocalTransparencyModifier=math.clamp(C.xrayOpacity/100,0,1) end)
	end
end
local function clearXrayFrom(p)
	if p:IsA("BasePart") and not isCharPart(p) then
		pcall(function() p.LocalTransparencyModifier=0 end)
	end
end
function S.clearXray()
	for _,o in ipairs(workspace:GetDescendants()) do clearXrayFrom(o) end
end
function S.applyXrayAll()
	for _,o in ipairs(workspace:GetDescendants()) do applyXray(o) end
end
addR("Visual",t("xray").." ("..C.xrayOpacity.."%)",function(b,a)
	if a=="toggle" then
		C.xrayEn=not C.xrayEn
		if C.xrayEn then
			b.BackgroundColor3=Color3.fromRGB(0,120,0)
			S.applyXrayAll()
			S.conns.XrayAdd=workspace.DescendantAdded:Connect(function(o)
				if not C.xrayEn then return end
				if o:IsA("BasePart") then task.defer(function() task.wait(0.15); if C.xrayEn and o.Parent then applyXray(o) end end) end
			end)
		else b.BackgroundColor3=Color3.fromRGB(50,50,50); S.dis("XrayAdd"); S.clearXray() end
	elseif a=="minus" then C.xrayOpacity=math.max(0,C.xrayOpacity-10); if C.xrayEn then S.applyXrayAll() end
	elseif a=="plus" then C.xrayOpacity=math.min(100,C.xrayOpacity+10); if C.xrayEn then S.applyXrayAll() end end
	b.Text=t("xray")..": "..(C.xrayEn and t("on") or t("off")).." ("..C.xrayOpacity.."%)"
end,true,"xrayEn","xrayOpacity")

local fbSaved=nil
addR("Visual",t("fullbright"),function(b,a)
	if a~="toggle" then
		if C.fbEn then b.Text=t("fullbright")..": "..t("on"); b.BackgroundColor3=Color3.fromRGB(0,120,0)
		else b.Text=t("fullbright")..": "..t("off"); b.BackgroundColor3=Color3.fromRGB(50,50,50) end
		return
	end
	C.fbEn=not C.fbEn
	local L2=Lighting
	if C.fbEn then
		if not fbSaved then
			local atm=L2:FindFirstChildOfClass("Atmosphere")
			fbSaved={Ambient=L2.Ambient,OutdoorAmbient=L2.OutdoorAmbient,Brightness=L2.Brightness,FogEnd=L2.FogEnd,FogStart=L2.FogStart,GlobalShadows=L2.GlobalShadows,ClockTime=L2.ClockTime,EnvironmentDiffuseScale=L2.EnvironmentDiffuseScale,EnvironmentSpecularScale=L2.EnvironmentSpecularScale,AtmDensity=atm and atm.Density or nil,AtmHaze=atm and atm.Haze or nil}
		end
		b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("fullbright")..": "..t("on")
		S.addT("Fullbright",function()
			L2.Ambient=Color3.fromRGB(255,255,255); L2.OutdoorAmbient=Color3.fromRGB(255,255,255)
			L2.Brightness=2; L2.FogEnd=1e9; L2.FogStart=1e9; L2.GlobalShadows=false; L2.ClockTime=12
			L2.EnvironmentDiffuseScale=1; L2.EnvironmentSpecularScale=0
			local atm=L2:FindFirstChildOfClass("Atmosphere")
			if atm then atm.Density=0; atm.Haze=0 end
		end,0.1)
	else
		b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("fullbright")..": "..t("off")
		S.delT("Fullbright")
		if fbSaved then pcall(function()
			L2.Ambient=fbSaved.Ambient; L2.OutdoorAmbient=fbSaved.OutdoorAmbient
			L2.Brightness=fbSaved.Brightness; L2.FogEnd=fbSaved.FogEnd; L2.FogStart=fbSaved.FogStart
			L2.GlobalShadows=fbSaved.GlobalShadows; L2.ClockTime=fbSaved.ClockTime
			L2.EnvironmentDiffuseScale=fbSaved.EnvironmentDiffuseScale; L2.EnvironmentSpecularScale=fbSaved.EnvironmentSpecularScale
			local atm=L2:FindFirstChildOfClass("Atmosphere")
			if atm then if fbSaved.AtmDensity then atm.Density=fbSaved.AtmDensity end; if fbSaved.AtmHaze then atm.Haze=fbSaved.AtmHaze end end
		end) end
	end
end,false,"fbEn")

local nofogSaved=nil
addR("Visual",t("nofog"),function(b,a)
	if a~="toggle" then
		if C.nofogEn then b.Text=t("nofog")..": "..t("on"); b.BackgroundColor3=Color3.fromRGB(0,120,0)
		else b.Text=t("nofog")..": "..t("off"); b.BackgroundColor3=Color3.fromRGB(50,50,50) end
		return
	end
	C.nofogEn=not C.nofogEn
	local L2=Lighting
	if C.nofogEn then
		if not nofogSaved then
			nofogSaved={FogEnd=L2.FogEnd, FogStart=L2.FogStart}
			local atm=L2:FindFirstChildOfClass("Atmosphere")
			if atm then
				nofogSaved.AtmDensity=atm.Density
				nofogSaved.AtmHaze=atm.Haze
				nofogSaved.AtmOffset=atm.Offset
			end
		end
		b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("nofog")..": "..t("on")
		S.addT("NoFog",function()
			L2.FogEnd=1e7; L2.FogStart=1e7
			local atm=L2:FindFirstChildOfClass("Atmosphere")
			if atm then atm.Density=0; atm.Haze=0; atm.Offset=0 end
		end,0.2)
	else
		b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("nofog")..": "..t("off")
		S.delT("NoFog")
		if nofogSaved then pcall(function()
			L2.FogEnd=nofogSaved.FogEnd; L2.FogStart=nofogSaved.FogStart
			local atm=L2:FindFirstChildOfClass("Atmosphere")
			if atm then
				if nofogSaved.AtmDensity then atm.Density=nofogSaved.AtmDensity end
				if nofogSaved.AtmHaze then atm.Haze=nofogSaved.AtmHaze end
				if nofogSaved.AtmOffset then atm.Offset=nofogSaved.AtmOffset end
			end
		end) end
		nofogSaved=nil
	end
end,false,"nofogEn")

local fovSaved=nil
addR("Visual",t("fov").." ("..C.fovValue..")",function(b,a)
	if a=="toggle" then
		C.fovEn=not C.fovEn
		if C.fovEn then
			fovSaved=Cam.FieldOfView
			Cam.FieldOfView=C.fovValue
		else
			if fovSaved then Cam.FieldOfView=fovSaved; fovSaved=nil end
		end
	elseif a=="minus" then
		C.fovValue=math.max(10,C.fovValue-5)
		if C.fovEn then Cam.FieldOfView=C.fovValue end
	elseif a=="plus" then
		C.fovValue=C.fovValue+5
		if C.fovEn then Cam.FieldOfView=C.fovValue end
	end
	if C.fovEn then b.BackgroundColor3=Color3.fromRGB(0,120,0); b.Text=t("fov")..": "..t("on").." ("..C.fovValue..")"
	else b.BackgroundColor3=Color3.fromRGB(50,50,50); b.Text=t("fov")..": "..t("off").." ("..C.fovValue..")" end
end,true,"fovEn","fovValue")
print("[UCS] Visual ok")

-- ============================================================
-- WP
-- ============================================================
local WP_FILE="UCS_Waypoints.json"
local waypoints={}
local function saveWP() pcall(function() writefile(WP_FILE,Http:JSONEncode(waypoints)) end) end
local function loadWP() pcall(function()
	if isfile and isfile(WP_FILE) then
		local data=Http:JSONDecode(readfile(WP_FILE))
		if type(data)=="table" then
			for k,v in pairs(data) do
				if type(v)=="table" and v.x and v.y and v.z then waypoints[k]={x=v.x,y=v.y,z=v.z} end
			end
		end
	end
end) end
loadWP()
local wpName=Instance.new("TextBox",S.Tabs.WP)
wpName.Size=UDim2.new(1,-5,0,30); wpName.BackgroundColor3=Color3.fromRGB(45,45,45)
wpName.BorderSizePixel=0; wpName.Text=""; wpName.PlaceholderText=t("wp_name_ph")
wpName.TextColor3=Color3.new(1,1,1); wpName.PlaceholderColor3=Color3.fromRGB(140,140,140)
wpName.Font=Enum.Font.SourceSansBold; wpName.TextSize=12
wpName.ClearTextOnFocus=false; wpName.TextXAlignment=Enum.TextXAlignment.Left; wpName.LayoutOrder=1
Instance.new("UICorner",wpName).CornerRadius=UDim.new(0,4)
local function autoName() local n=1 while waypoints[tostring(n)] do n=n+1 end return tostring(n) end
local wpSave=addR("WP",t("wp_save"),function(b)
	local name=(wpName.Text or ""):gsub("^%s+",""):gsub("%s+$","")
	if name=="" then name=autoName() end
	if waypoints[name] then S.notify(t("n_name_taken"),Color3.fromRGB(255,80,80)); return end
	local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	waypoints[name]={x=root.Position.X,y=root.Position.Y,z=root.Position.Z}
	saveWP(); if S.refreshWP then S.refreshWP() end
	wpName.Text=""
	S.notify(t("n_point_saved").." "..name,Color3.fromRGB(0,180,0))
	b.BackgroundColor3=Color3.fromRGB(0,120,180); task.wait(0.3); b.BackgroundColor3=Color3.fromRGB(50,50,50)
end,false)
if wpSave and wpSave.Parent then wpSave.Parent.LayoutOrder=2 end
local wpClear=addR("WP",t("wp_clear"),function(b)
	waypoints={}; saveWP(); if S.refreshWP then S.refreshWP() end
	b.BackgroundColor3=Color3.fromRGB(120,50,50); task.wait(0.3); b.BackgroundColor3=Color3.fromRGB(50,50,50)
end,false)
if wpClear and wpClear.Parent then wpClear.Parent.LayoutOrder=3 end
local WPlf=Instance.new("Frame",S.Tabs.WP)
WPlf.Size=UDim2.new(1,-5,0,0); WPlf.AutomaticSize=Enum.AutomaticSize.Y
WPlf.BackgroundTransparency=1; WPlf.LayoutOrder=4
Instance.new("UIListLayout",WPlf).Padding=UDim.new(0,4)
local function refreshWP()
	for _,c in ipairs(WPlf:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	local sorted={}; for name in pairs(waypoints) do sorted[#sorted+1]=name end
	table.sort(sorted,function(a,b)
		local na=tonumber(a); local nb=tonumber(b)
		if na and nb then return na<nb end
		if na then return true end
		if nb then return false end
		return a<b
	end)
	for _,name in ipairs(sorted) do
		local pos=waypoints[name]
		local row=Instance.new("Frame",WPlf); row.Size=UDim2.new(1,0,0,30)
		row.BackgroundColor3=Color3.fromRGB(50,50,50); row.BorderSizePixel=0
		Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
		local lbl=Instance.new("TextLabel",row)
		lbl.Size=UDim2.new(1,-90,1,0); lbl.Position=UDim2.new(0,6,0,0)
		lbl.BackgroundTransparency=1; lbl.Text=name; lbl.TextColor3=Color3.new(1,1,1)
		lbl.Font=Enum.Font.SourceSansBold; lbl.TextSize=11
		lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.TextTruncate=Enum.TextTruncate.AtEnd
		local tp=Instance.new("TextButton",row)
		tp.Size=UDim2.new(0,38,1,-4); tp.Position=UDim2.new(1,-84,0,2)
		tp.BackgroundColor3=Color3.fromRGB(0,120,180); tp.BorderSizePixel=0
		tp.Text="TP"; tp.TextColor3=Color3.new(1,1,1); tp.Font=Enum.Font.SourceSansBold; tp.TextSize=11
		Instance.new("UICorner",tp).CornerRadius=UDim.new(0,3)
		local del=Instance.new("TextButton",row)
		del.Size=UDim2.new(0,38,1,-4); del.Position=UDim2.new(1,-42,0,2)
		del.BackgroundColor3=Color3.fromRGB(150,40,40); del.BorderSizePixel=0
		del.Text="X"; del.TextColor3=Color3.new(1,1,1); del.Font=Enum.Font.SourceSansBold; del.TextSize=12
		Instance.new("UICorner",del).CornerRadius=UDim.new(0,3)
		tp.MouseButton1Click:Connect(function()
			local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			if not root then return end
			S.skipTPNow(1); root.Velocity=Vector3.zero; root.CFrame=CFrame.new(pos.x,pos.y+3,pos.z)
		end)
		del.MouseButton1Click:Connect(function() waypoints[name]=nil; saveWP(); refreshWP() end)
	end
end
S.refreshWP=refreshWP
refreshWP()
S.waypoints=waypoints
print("[UCS] WP ok")

