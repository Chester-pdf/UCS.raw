pcBtn.TextColor3=Color3.new(1,1,1)
pcBtn.Font=Enum.Font.SourceSansBold; pcBtn.TextSize=11
pcBtn.TextWrapped=true
Instance.new("UICorner", pcBtn).CornerRadius=UDim.new(0,6)

local mobBtn = Instance.new("TextButton", WP)
mobBtn.Size = UDim2.new(1,-20,0,42); mobBtn.Position = UDim2.new(0,10,0,176)
mobBtn.BorderSizePixel=0
mobBtn.TextColor3=Color3.new(1,1,1)
mobBtn.Font=Enum.Font.SourceSansBold; mobBtn.TextSize=11
mobBtn.TextWrapped=true
Instance.new("UICorner", mobBtn).CornerRadius=UDim.new(0,6)

local kbHead = Instance.new("TextLabel", WP)
kbHead.Size = UDim2.new(1,-20,0,16); kbHead.Position = UDim2.new(0,10,0,228)
kbHead.BackgroundTransparency = 1
kbHead.Text = wt("kb_head")
kbHead.TextColor3 = Color3.fromRGB(180,220,255)
kbHead.Font = Enum.Font.SourceSansBold; kbHead.TextSize=11
kbHead.TextXAlignment = Enum.TextXAlignment.Left

local kbRows = {
	{"RightShift","kb_panel"},
	{"LeftCtrl","kb_dash"},
	{"F","kb_fly"},
	{"N","kb_noclip"},
	{"C","kb_platform"},
	{"V","kb_freeze_player"},
	{"B","kb_freeze_cam"},
	{"Alt+R","kb_respawn"},
}
local kbLbls = {}
for i, row in ipairs(kbRows) do
	local y = 248 + (i-1)*20
	local key = Instance.new("TextLabel", WP)
	key.Size=UDim2.new(0,80,0,18); key.Position=UDim2.new(0,20,0,y)
	key.BackgroundColor3=Color3.fromRGB(42,42,42); key.BorderSizePixel=0
	key.Text=row[1]
	key.TextColor3=Color3.fromRGB(255,180,80)
	key.Font=Enum.Font.Code; key.TextSize=10
	Instance.new("UICorner", key).CornerRadius=UDim.new(0,4)
	local desc = Instance.new("TextLabel", WP)
	desc.Size=UDim2.new(1,-120,0,18); desc.Position=UDim2.new(0,110,0,y)
	desc.BackgroundTransparency=1
	desc.TextColor3=Color3.fromRGB(220,220,220)
	desc.Font=Enum.Font.SourceSans; desc.TextSize=11
	desc.TextXAlignment=Enum.TextXAlignment.Left
	table.insert(kbLbls, {lbl=desc, key=row[2]})
end

local cont = Instance.new("TextButton", WP)
cont.Size=UDim2.new(1,-24,0,40); cont.Position=UDim2.new(0,12,1,-52)
cont.BorderSizePixel=0
cont.TextColor3=Color3.fromRGB(20,20,20)
cont.Font=Enum.Font.SourceSansBold; cont.TextSize=13
Instance.new("UICorner", cont).CornerRadius=UDim.new(0,6)

local function refreshUI()
	title.Text = wt("title")
	langLbl.Text = wt("choose_lang")
	devLbl.Text = wt("choose_dev")
	pcBtn.Text = wt("dev_pc").."\n"..wt("dev_pc_desc")
	mobBtn.Text = wt("dev_mob").."\n"..wt("dev_mob_desc")
	kbHead.Text = wt("kb_head")
	for _, e in ipairs(kbLbls) do e.lbl.Text = wt(e.key) end
	ruBtn.BackgroundColor3 = (curLang=="ru") and Color3.fromRGB(0,120,0) or Color3.fromRGB(45,45,45)
	enBtn.BackgroundColor3 = (curLang=="en") and Color3.fromRGB(0,120,0) or Color3.fromRGB(45,45,45)
	pcBtn.BackgroundColor3 = (curDev=="pc") and Color3.fromRGB(0,120,0) or Color3.fromRGB(45,45,45)
	mobBtn.BackgroundColor3 = (curDev=="mobile") and Color3.fromRGB(0,120,0) or Color3.fromRGB(45,45,45)
	if curDev then
		cont.BackgroundColor3 = Color3.fromRGB(255,140,0)
		cont.Text = wt("cont")
		cont.AutoButtonColor = true
	else
		cont.BackgroundColor3 = Color3.fromRGB(80,80,80)
		cont.Text = wt("cont_wait")
		cont.AutoButtonColor = false
	end
end

ruBtn.MouseButton1Click:Connect(function() curLang="ru"; refreshUI() end)
enBtn.MouseButton1Click:Connect(function() curLang="en"; refreshUI() end)
pcBtn.MouseButton1Click:Connect(function() curDev="pc"; refreshUI() end)
mobBtn.MouseButton1Click:Connect(function() curDev="mobile"; refreshUI() end)

cont.MouseButton1Click:Connect(function()
	if not curDev then return end
	pcall(function()
		writefile(DEVICE_FILE, Http:JSONEncode({device=curDev, lang=curLang, ts=os.time()}))
	end)
	SG:Destroy()
	task.defer(function() loadCore(curDev, curLang) end)
end)

refreshUI()
