Op.Text="UNIVERSAL CHEAT SCRIPT"; Op.BackgroundColor3=Color3.fromRGB(42,42,42)
Op.TextColor3=Color3.fromRGB(255,140,0); Op.Font=Enum.Font.SourceSansBold
Op.TextSize=10; Op.Visible=false
