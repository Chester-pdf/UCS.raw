local cornerKeys={TL="corner_tl",TR="corner_tr",BL="corner_bl",BR="corner_br"}
addR("Settings",t("stealth_corner").." ("..t(cornerKeys[C.stealthCorner] or "corner_tl")..")",function(b,a)
	if a=="toggle" then
		if C.stealthCorner=="TL" then C.stealthCorner="TR"
		elseif C.stealthCorner=="TR" then C.stealthCorner="BR"
		elseif C.stealthCorner=="BR" then C.stealthCorner="BL"
		else C.stealthCorner="TL" end
	end
	b.Text=t("stealth_corner").." ("..t(cornerKeys[C.stealthCorner] or "corner_tl")..")"
end,false,"stealthCorner")

