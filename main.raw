-- ============================================================
-- UCS LOADER v1.4.0
-- ============================================================
print("[UCS] loader v1.4.0")

if _G.UCS_Unload then pcall(_G.UCS_Unload) end
_G.UCS = nil
_G._UCS_AddLoaded = nil
_G.UCS_PresetLang = nil
_G.UCS_Device = nil

local Http=game:GetService("HttpService")
local Players=game:GetService("Players")
local LP=Players.LocalPlayer

local BASE = "https://raw.githubusercontent.com/Chester-pdf/USC.raw/main/"
local DEVICE_FILE = "UCS_Device.json"

local saved = nil
pcall(function()
	if isfile and isfile(DEVICE_FILE) then
		local d = Http:JSONDecode(readfile(DEVICE_FILE))
		if type(d)=="table" and d.device and d.lang then saved = d end
	end
end)

local function loadCore(device, lang)
	local file = (device == "mobile") and "mainM.raw" or "mainPC.raw"
	local url = BASE .. file .. "?t=" .. tostring(os.time())
	print("[UCS] loading "..file.." lang="..lang)
	_G.UCS_PresetLang = lang
	_G.UCS_Device = device
	local ok, src = pcall(game.HttpGet, game, url)
	if not ok or not src or #src < 500 then
		warn("[UCS] failed to download "..file)
		return
	end
	local fn, err = loadstring(src)
	if not fn then warn("[UCS] syntax: "..tostring(err)); return end
	local ok2, err2 = pcall(fn)
	if not ok2 then warn("[UCS] runtime: "..tostring(err2)) end
end

if saved then
	print("[UCS] auto-start device="..saved.device.." lang="..saved.lang)
	task.spawn(function() loadCore(saved.device, saved.lang) end)
	return
end

-- ============ WELCOME ============
local pG = LP:WaitForChild("PlayerGui", 15)
if not pG then return end

local SG = Instance.new("ScreenGui")
SG.Name = "UCS_Welcome"
SG.ResetOnSpawn = false
SG.IgnoreGuiInset = true
SG.DisplayOrder = 2147483647
SG.Parent = pG

local W = {
	ru = {
		title="Добро пожаловать в UCS!",
		choose_lang="Выбери язык",
		choose_dev="Выбери устройство",
		dev_pc="💻 Компьютер",
		dev_pc_desc="Клавиатура и мышь, без экранных кнопок",
		dev_mob="📱 Телефон / планшет",
		dev_mob_desc="Экранные кнопки, тач-управление",
		kb_head="⌨ Горячие клавиши (для ПК):",
		kb_panel="Вкл/выкл панель",
		kb_dash="Рывок (Dash)",
		kb_respawn="Респавн себя",
		kb_fly="Полёт",
		kb_noclip="Ноуклип",
		kb_platform="Платформа",
		kb_freeze_player="Заморозить игрока, камера двигается",
		kb_freeze_cam="Заморозить камеру, игрок двигается",
		cont="Продолжить и начать",
		cont_wait="Выбери язык и устройство",
	},
	en = {
		title="Welcome to UCS!",
		choose_lang="Choose language",
		choose_dev="Choose your device",
		dev_pc="💻 PC",
		dev_pc_desc="Keyboard & mouse, no on-screen buttons",
		dev_mob="📱 Phone / tablet",
		dev_mob_desc="On-screen buttons, touch controls",
		kb_head="⌨ Keyboard shortcuts (PC):",
		kb_panel="Toggle panel",
		kb_dash="Dash",
		kb_respawn="Respawn self",
		kb_fly="Fly",
		kb_noclip="Noclip",
		kb_platform="Platform",
		kb_freeze_player="Freeze player, camera moves",
		kb_freeze_cam="Freeze camera, player moves",
		cont="Continue and start using",
		cont_wait="Pick language and device",
	},
}
local curLang = "en"
local curDev = nil
local function wt(k)
	local tbl = W[curLang] or W.en
	return tbl[k] or W.en[k] or k
end

local WP = Instance.new("Frame", SG)
WP.Size = UDim2.new(0, 340, 0, 440)
WP.Position = UDim2.new(0.5, -170, 0.5, -220)
WP.BackgroundColor3 = Color3.fromRGB(22,22,28)
WP.BorderSizePixel = 0
Instance.new("UICorner", WP).CornerRadius = UDim.new(0,10)
Instance.new("UIStroke", WP).Color = Color3.fromRGB(255,140,0)

local corners = {
	UDim2.new(0,8,0,6),
	UDim2.new(1,-128,0,6),
	UDim2.new(0,8,1,-20),
	UDim2.new(1,-128,1,-20),
}
local wm = Instance.new("TextLabel", WP)
wm.Size = UDim2.new(0,120,0,14)
wm.Position = corners[math.random(1,4)]
wm.BackgroundTransparency = 1
wm.Text = "UCS v1.4.0 · @Chester-pdf"
