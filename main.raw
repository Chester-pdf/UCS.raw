devLbl.BackgroundTransparency = 1
devLbl.Text = wt("choose_dev")
devLbl.TextColor3 = Color3.fromRGB(200,200,200)
devLbl.Font = Enum.Font.SourceSans; devLbl.TextSize = 11
devLbl.TextXAlignment = Enum.TextXAlignment.Center

local pcBtn = Instance.new("TextButton", WP)
